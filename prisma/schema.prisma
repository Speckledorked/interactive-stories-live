//
// PHASE 11: DOWNTIME MODELS
//
// (Session/SessionParticipant/SessionScene/SessionNote lived here too, but
// were removed as dead schema — nothing ever created a Session row, so the
// "group scenes into a session" concept never had a real write path. See
// README's hardening backlog.)

enum ActivityStatus {
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

model DowntimeActivity {
  id          String         @id @default(cuid())
  characterId String
  description String         @db.Text // Natural language description
  summary     String         @db.Text // AI-generated summary
  status      ActivityStatus @default(ACTIVE)

  // AI-determined properties
  estimatedDays  Int
  currentDay     Int      @default(0)
  // {gold?: number, items?: [{name, quantity}], favor?: {counterparty_name,
  // counterparty_type, description}, requiresQuest?: {name, description,
  // givenBy}} — see lib/downtime/ai-downtime-service.ts. Each present cost
  // type is mechanically charged at creation (gold from
  // Character.resources, items from Character.inventory, favor as an
  // incurred Debt); requiresQuest spawns a real, tracked Quest rather than
  // gating completion on it.
  costs          Json?
  requirements   String[] // Prerequisites
  skillsInvolved String[] // Skills being used
  riskLevel      String? // low, medium, high
  // Set when costs.requiresQuest spawned a real Quest — informational
  // link, not an enforced completion gate (see costs comment above).
  linkedQuestId  String?

  outcomes     Json? // Potential outcomes
  finalOutcome String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  // #305: set when generateDynamicOutcomes's AI completion call (or the
  // parse/shape check on its response) fails AFTER the activity has
  // already been marked COMPLETED — the days genuinely passed, but the
  // outcome/reward payload was never generated, so gold/items/standing
  // were never applied. Null means no failure recorded (either it never
  // failed, or a retry has since succeeded and cleared it). Non-null makes
  // the loss visible/auditable instead of silent, and is what
  // advanceDynamicDowntime's retry pass queries on — the reward loop used
  // to only ever touch status: ACTIVE activities, so a COMPLETED one with
  // a lost reward previously had no path back into it at all.
  outcomeGenerationFailedAt DateTime?

  events DowntimeEvent[]

  @@index([characterId])
  @@index([status])
  @@index([characterId, outcomeGenerationFailedAt])
  // #211: a real partial unique index enforcing at most one ACTIVE activity
  // per character — created by hand-written migration SQL (Prisma's
  // @@unique has no WHERE clause), matching this schema's existing
  // NPC/Faction/Quest-name uniqueness precedent. The application-level
  // check in createDynamicActivity (ai-downtime-service.ts) is the primary
  // gate; this is the concurrency backstop for the race between two
  // concurrent requests both passing that check.
  @@map("downtime_activities")
}

model DowntimeEvent {
  id              String    @id @default(cuid())
  activityId      String
  dayNumber       Int
  eventText       String    @db.Text // AI-generated event
  choices         Json? // Available choices
  response        String?   @db.Text // Player response
  outcome         String?   @db.Text // Result of response
  // Depth-hardening follow-up (see lib/downtime/downtimeEventOutcome.ts):
  // deterministic, riskLevel-weighted category rolled server-side BEFORE
  // the AI narrates — "setback" | "complication" | "smooth" | "opportunity".
  // The AI is constrained to narrate within this category rather than
  // freely improvising the day's nature; null for events created before
  // this existed.
  outcomeCategory String?
  createdAt       DateTime  @default(now())
  respondedAt     DateTime?

  activity DowntimeActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("downtime_events")
}

