//
// PHASE 25: SAFETY TOOLS & CONTENT MODERATION
//

// Content-category taxonomy — what kind of content triggered the X-Card,
// not what surface it appeared on (XCardUse.targetId already records the
// specific message/scene/action id when that's known). Must stay in sync
// with the trigger <select> in src/components/safety/SimpleXCard.tsx —
// previously drifted (5 enum values vs. 11 UI options), silently 400ing
// 10 of 11 reasons.
enum XCardTrigger {
  GENERAL
  VIOLENCE
  GORE
  TRAUMA
  ABUSE
  DEATH
  PHOBIA
  SEXUAL
  SUBSTANCE
  MENTAL_HEALTH
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model CampaignSafetySettings {
  id         String @id @default(cuid())
  campaignId String @unique

  // X-Card settings
  xCardEnabled      Boolean @default(true)
  anonymousXCard    Boolean @default(true) // Don't show who used X-Card
  pauseOnXCard      Boolean @default(true)
  xCardNotifyGMOnly Boolean @default(false)

  // Lines and Veils (pre-game safety discussion) — hard/soft content
  // boundaries, enforced by feeding both into the <safety> prompt section
  // (see lib/ai/worldState.ts, lib/ai/client.ts). Lines must never appear;
  // veils may be implied but never detailed.
  lines String[] // Hard boundaries - will not be included
  veils String[] // Soft boundaries - will be implied, not detailed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaign_safety_settings")
}

model XCardUse {
  id         String  @id @default(cuid())
  campaignId String
  sceneId    String?
  userId     String

  trigger     XCardTrigger
  targetId    String? // ID of message, action, scene, etc.
  reason      String?      @db.Text // Optional explanation
  isAnonymous Boolean      @default(true)

  // GM/Moderator response
  acknowledged   Boolean   @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolution     String?   @db.Text

  createdAt DateTime @default(now())

  @@index([campaignId, createdAt])
  @@index([sceneId])
  @@map("x_card_uses")
}

model ContentReport {
  id         String @id @default(cuid())
  reporterId String
  campaignId String

  // What's being reported
  contentType String // "message", "note", "character", "scene", "user_behavior"
  contentId   String?
  contentText String? @db.Text

  reason   String         @db.Text
  category String? // harassment, inappropriate_content, cheating, other
  severity ReportSeverity @default(MEDIUM)
  status   ReportStatus   @default(PENDING)

  // Moderation
  reviewedBy  String?
  reviewedAt  DateTime?
  resolution  String?   @db.Text
  actionTaken String? // warning, content_removed, user_banned, dismissed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status])
  @@index([reporterId])
  @@index([status, severity])
  @@map("content_reports")
}

model UserBlock {
  id            String  @id @default(cuid())
  userId        String // User doing the blocking
  blockedUserId String // User being blocked
  campaignId    String? // Optional: block only in specific campaign
  reason        String? @db.Text

  createdAt DateTime @default(now())

  @@unique([userId, blockedUserId, campaignId])
  @@index([userId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

model CampaignBan {
  id          String    @id @default(cuid())
  campaignId  String
  userId      String
  bannedBy    String // GM/Admin who issued the ban
  reason      String    @db.Text
  isPermanent Boolean   @default(false)
  expiresAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_bans")
}

//
// PAYMENT & TRANSACTION TRACKING
//

enum TransactionType {
  CREDIT // User added funds
  DEBIT // AI usage charge
  REFUND // Refund issued
  ADJUSTMENT // Manual adjustment
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Int // In cents (positive for credit, negative for debit)
  balanceBefore Int // Balance before transaction
  balanceAfter  Int // Balance after transaction
  description   String
  metadata      Json? // Additional info (e.g., sceneId, tokens used, etc.)
  createdAt     DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("transactions")
}

// Per-request AI cost ledger — durable and queryable by scene, unlike
// WorldMeta.aiMetrics.requestHistory (a rolling 50-entry JSON array shared
// across the WHOLE campaign, which can silently evict a scene's own entries
// once enough other calls interleave). This is what metered scene billing
// (resolutionBilling.ts) actually sums; aiMetrics stays as-is for the
// admin analytics dashboard's running totals.
model AICostEntry {
  id           String   @id @default(cuid())
  campaignId   String
  sceneId      String? // null for campaign-level calls not tied to one scene (world turn, lore import, ...)
  requestType  String
  model        String
  inputTokens  Int
  outputTokens Int
  costMicros   Int // cost in millionths of a dollar (1,000,000 = $1) — real per-call AI cost is often sub-cent, so cents would round most entries to zero
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([sceneId])
  @@index([createdAt])
}

//
// CAMPAIGN LOG & PROGRESSION TRACKING
//

model CampaignLog {
  id         String  @id @default(cuid())
  campaignId String
  sceneId    String? // Optional link to specific scene
  turnNumber Int

  // Content
  title      String
  summary    String   @db.Text // AI-generated summary of what happened
  highlights String[] // Key events or important moments
  entryType  String   @default("scene") // scene, downtime, world_event, milestone

  // Timeline tracking. Both fields existed long before they had a writer:
  // generateCampaignLog (sceneResolver.ts) never set either one, so every
  // AI-generated entry had them null regardless of what the UI rendered.
  // Now actually populated at write time, from formatInGameDate/
  // hoursThisExchange — see lib/game/calendar.ts.
  inGameDate String? // Formatted in-game date/time, frozen at write time
  duration   String? // How much in-game time passed (e.g., "2 hours", "3 days")

  // Absolute in-game day number since campaign epoch at time of writing —
  // groupable/filterable, unlike the free-text inGameDate string above.
  // Null for every entry written before this field existed; never
  // backfilled retroactively (see lib/game/calendarBackfill.ts's header
  // comment for why an exact historical reconstruction isn't attempted).
  inGameDayNumber Int?

  // #264: smallest real signal of whether shareable recaps are used at all.
  // Incremented once per successful load of the public recap page
  // (GET /api/public/chronicle/[token]/recap/[logId]) — not when a share
  // link is merely copied/generated.
  recapViewCount Int @default(0)

  createdAt DateTime @default(now())

  @@index([campaignId, turnNumber])
  @@index([campaignId, inGameDayNumber])
  @@index([sceneId])
  @@map("campaign_logs")
}

//
// CAMPAIGN WIKI & KNOWLEDGE BASE
//

enum WikiEntryType {
  NPC
  FACTION
  LOCATION
  CLOCK
  ITEM
  QUEST
  LORE
  CUSTOM
}

model WikiEntry {
  id         String        @id @default(cuid())
  campaignId String
  entryType  WikiEntryType

  // Basic info
  name        String
  summary     String @db.Text // Short description
  description String @db.Text // Full details

  // Metadata
  tags     String[] // For filtering/searching
  aliases  String[] // Alternative names
  imageUrl String? // Optional image

  // Cross-references to other wiki entries: [{ id, type, relationship }].
  // Written by the tick's wiki sync (an NPC links to their faction and
  // location, a faction to its territories) and rendered as navigable
  // links on the wiki page. Was a dead column with no writer, reader or UI
  // for a long time (README #90).
  relatedEntries Json?

  // Status tracking
  isActive     Boolean @default(true)
  lastSeenTurn Int? // Last turn this was mentioned/updated
  importance   String  @default("normal") // minor, normal, major, critical

  // History
  changelog Json? // Array of {turn, change, summary} for tracking updates

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @default("ai") // ai or userId

  @@index([campaignId, entryType])
  @@index([campaignId, name])
  @@index([campaignId, isActive])
  @@map("wiki_entries")
}

//
// CAMPAIGN MEMORY & RAG SYSTEM
//

enum MemoryType {
  SCENE
  NPC_INTERACTION
  FACTION_EVENT
  LOCATION_EVENT
  CHARACTER_MOMENT
  CLOCK_COMPLETION
  WORLD_EVENT
}

enum MemoryImportance {
  MINOR
  NORMAL
  MAJOR
  CRITICAL
}

model CampaignMemory {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // What this memory is about
  memoryType MemoryType
  sourceId   String // ID of source (sceneId, npcId, factionId, etc.)
  turnNumber Int

  // Searchable content
  title       String
  summary     String @db.Text // 2-3 sentence summary
  fullContext String @db.Text // Full scene resolution or event description

  // Vector embedding (pgvector type)
  // Using Unsupported because Prisma doesn't have built-in vector support yet
  embedding Unsupported("vector(1536)")? // OpenAI ada-002 produces 1536 dimensions

  // Entity tracking (for targeted retrieval)
  involvedCharacterIds String[] @default([])
  involvedNpcIds       String[] @default([])
  involvedFactionIds   String[] @default([])
  locationTags         String[] @default([])

  // Importance weighting
  importance    MemoryImportance @default(NORMAL)
  emotionalTone String? // "tense", "triumphant", "tragic", etc.
  tags          String[]         @default([]) // ["combat", "betrayal", "alliance", etc.]

  // How often this memory has actually proven useful at retrieval time —
  // distinct from importance (which is set once, at creation) or recency
  // (turnNumber, when it happened). Bumped by memoryRetrieval.ts's
  // retrieveRelevantHistory on every real retrieval; read by
  // memoryConsolidation.ts to exempt frequently-useful memories from being
  // rolled into an era summary, the same way MAJOR/CRITICAL importance
  // already is (see #107).
  retrievalCount    Int  @default(0)
  lastRetrievedTurn Int?

  createdAt DateTime @default(now())

  @@index([campaignId, turnNumber])
  @@index([campaignId, memoryType])
  @@index([campaignId, importance])
  @@map("campaign_memories")
}

//
// LORE IMPORT — reference material (pasted text, a URL, or an entire wiki)
// chunked and embedded the same way CampaignMemory is, but for static
// world-bible content rather than "things that happened in play". See
// lib/lore/ (collection + chunking) and lib/ai/loreRetrieval.ts (semantic
// search, mirrors memoryRetrieval.ts).
//

enum LoreSourceType {
  PASTE
  URL
  WIKI
}

enum LoreImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model LoreImportJob {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  sourceType  LoreSourceType
  sourceUrl   String? // for URL / WIKI
  sourceTitle String? // display name shown in the admin UI
  rawText     String?        @db.Text // for PASTE

  status    LoreImportJobStatus @default(PENDING)
  attempts  Int                 @default(0)
  lastError String?

  // Set once a global stuck-job sweep (lib/jobs/stuckJobAlert.ts) has fired
  // an alert for this job — see the identical field on ResolutionJob.
  alertedStuckAt DateTime?

  // Set when the campaign was created WITH this lore source: on completion
  // the worker automatically reseeds the world from the imported canon
  // (lib/lore/reseedWorld.ts) instead of waiting for the admin button.
  // While such a job is in flight the campaign is unplayable — see
  // Campaign.pendingWorldSeed.
  autoReseedOnComplete Boolean @default(false)

  // WIKI only: real category titles (as returned by the wiki's own
  // list=allcategories, e.g. "Characters", "Teams") the admin picked to
  // skip during the crawl — resolved to member page titles at crawl time
  // (see mediaWikiClient.ts's fetchCategoryMembers), not stored here.
  // Lets a wiki-heavy-on-named-cast import spend its page budget on
  // world-building content instead.
  excludeCategories String[] @default([])

  // Progress, shown to the admin while a wiki crawl is running.
  pagesFound     Int @default(0)
  pagesDone      Int @default(0)
  entriesCreated Int @default(0)
  // #243 (adversarial audit): the wiki's real candidate-page count before
  // the hard WIKI_MAX_PAGES cut (loreImportService.ts) truncated it down
  // to pagesFound. A large wiki previously lost content on import with no
  // signal anywhere that anything had been dropped — this is what lets
  // the admin UI show "Imported 400 of 612 pages" instead of just "400."
  // 0 for PASTE/URL sources (never truncated) and for a WIKI job that
  // predates this field.
  pagesAvailable Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  entries LoreEntry[]

  @@index([campaignId, status])
}

model LoreEntry {
  id         String        @id @default(cuid())
  campaignId String
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  jobId      String
  job        LoreImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title     String
  sourceUrl String? // the specific page this chunk came from, for WIKI/URL sources
  content   String  @db.Text // one chunk — see lib/lore/textChunker.ts

  embedding Unsupported("vector(1536)")?

  tags String[] @default([])

  // SHA-256 of `content`, scoped to (jobId, contentHash) rather than
  // (campaignId, contentHash) deliberately: a genuinely separate later
  // import of the same source material is allowed to create a fresh
  // entry (that's a new job, a new intentional import), but a RETRY of
  // the SAME job — recovered by stale-job sweeping, or re-fired by hand
  // after a partial failure — must not re-insert chunks it already
  // stored. storeLoreChunks (loreImportService.ts) upserts on this key
  // instead of a bare INSERT, so a job that starts over from page 0
  // after a mid-crawl failure resumes for free rather than duplicating
  // every already-stored chunk.
  contentHash String

  createdAt DateTime @default(now())

  @@unique([jobId, contentHash])
  @@index([campaignId])
  @@index([jobId])
  @@map("lore_entries")
}

// Records which imported lore actually reached a scene's prompt, so "why
// did this narration mention that fact" is a real query (join through
// sceneId/loreEntryId) instead of a guess from reading the narration back
// against the lore library by hand. Written best-effort right after
// retrieveRelevantLore (loreRetrieval.ts) runs, from
// buildSceneResolutionRequest — never allowed to block scene resolution if
// the write fails, same as AIValidationFailure below. Loosely coupled by
// design (no @relation, matching AIValidationFailure/AnalyticsEvent): a
// citation for a scene or lore entry that's since been deleted still
// counts as real history and must never fail on a constraint.
model LoreCitation {
  id          String   @id @default(cuid())
  campaignId  String
  sceneId     String
  loreEntryId String
  similarity  Float
  createdAt   DateTime @default(now())

  @@index([campaignId])
  @@index([sceneId])
  @@index([loreEntryId])
  @@map("lore_citations")
}

enum ReseedJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// One attempt at reseedWorldFromLore (lib/lore/reseedWorld.ts), run off
// the request path like lore import itself — see lib/lore/reseedQueue.ts
// for why. reseedWorldFromLore's writes are incremental against current
// DB state, so an attempt whose invocation gets killed mid-run and gets
// retried doesn't redo finished work.
model ReseedJob {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  status    ReseedJobStatus @default(PENDING)
  attempts  Int             @default(0)
  lastError String?

  // Set once a global stuck-job sweep (lib/jobs/stuckJobAlert.ts) has
  // fired an alert for this job — mirrors the identical field on
  // LoreImportJob/ResolutionJob.
  alertedStuckAt DateTime?

  // Set when this job exists to satisfy the creation-time auto-reseed
  // (Campaign.pendingWorldSeed) rather than a manual admin re-run —
  // mirrors LoreImportJob.autoReseedOnComplete. Either way, the play lock
  // is released once this job reaches a terminal state.
  releasesPlayLock Boolean @default(false)

  // Admin opt-in only: normally a "live" campaign (characters already
  // exist) treats stat labels as fill-only, same as everything else in
  // live mode — never overwriting what's already in play. Stat labels are
  // pure display flavor over the five fixed stat keys (see
  // lib/pbta-moves.ts), never the underlying numbers a character's sheet
  // stores, so overwriting them retroactively is safe in a way overwriting
  // factions/archetypes would not be. This lets an admin who imported lore
  // (or generated a character) before getting canon-accurate labels fix
  // that without a full fresh-mode reseed touching anything else.
  forceStatLabels Boolean @default(false)

  // The completed run's summary (ReseedSummary), so the admin UI can
  // render exactly what changed without re-deriving it.
  summary Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([campaignId, status])
}

//
// WORLD SIM — PERSISTED EVENT STREAM
//
// Every deterministic tick change and player-action consequence gets written
// here, not just the "significant" ones (those additionally get written to
// CampaignMemory for RAG, and trigger a WikiEntry refresh — this table is
// the durable, structured record all of that already derives from). Future
// systems (rumors, economy, analytics, recaps) read from this table instead
// of coupling directly to the simulation systems that produced the events.

model WorldEvent {
  id         String   @id @default(cuid())
  campaignId String
  turnNumber Int
  createdAt  DateTime @default(now())

  // A short, filterable key: "<targetType>.<field>", e.g. "faction.resources",
  // "npc.currentPlan", "location_weather.weather"
  type   String
  origin String // "tick" | "consequence" — mirrors WorldChange.origin

  actorType WorldEventActorType @default(SYSTEM)
  // No per-character attribution yet — consequence extraction operates on
  // scene text as a whole, not per-player-action, so PLAYER events can't be
  // pinned to a specific user/character today. actorId stays null until
  // that's threaded through.
  actorId   String?

  targetType WorldEventTargetType
  targetId   String
  targetName String

  field         String
  previousValue String?
  newValue      String?

  reason      String  @db.Text
  significant Boolean @default(false)
  importance  String  @default("NORMAL") // "NORMAL" | "MAJOR"

  // #101 v1.1: where this event actually happened, captured at write time
  // (e.g. the NPC's or contested location's id at the moment of the change)
  // rather than approximated later from the target entity's CURRENT
  // location, which drifts once the entity moves. Null for event types with
  // no single natural location (FACTION/QUEST/etc. — see informationTick.ts)
  // and for every pre-migration row — a valid, silent "nothing to show",
  // same convention as checkKey. No FK, matching targetId's existing
  // plain-string convention (target rows can be deleted independently).
  originLocationId String?

  // Set only for events from an Integrity Engine repair (game/integrity/),
  // to the IntegrityCheck.key that produced it — null for every ordinary
  // tick/consequence write. Without this, an integrity repair to
  // Character.relationships would be indistinguishable at the DB level from
  // an everyday scene-driven trust change to the same field on the same
  // character, which is the normal, frequent, entirely-expected case — the
  // escalation signal in integrity/escalation.ts depends on telling those
  // apart, not just "this field changed again."
  checkKey String?

  // #310: set only for origin: "wake" events, to ActiveWake.sourceType
  // ('NPC' | 'FACTION' | 'FACTION_DEFAULT') — without this, three
  // independent handlers (wakeTick.ts's NPC-death ripple, its
  // faction-collapse ripple, and economyTick.ts's loan-default cascade)
  // all write the identical (targetType FACTION, field "stability",
  // origin "wake") shape, so npcDispositionTick.ts/beliefTick.ts's
  // institutional-memory-loss classifiers couldn't tell a genuine
  // death/collapse from an ally merely defaulting on a bailout loan — the
  // latter got misread as the same "the faction abandoned them" signal as
  // the former. checkKey isn't reused for this: escalation.ts's own query
  // (`WHERE checkKey IS NOT NULL`) assumes every non-null row is an
  // integrity-repair candidate, so a wake-origin row parked there would
  // silently corrupt that unrelated signal.
  wakeSourceType String?

  campaign  Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  witnesses EventWitness[]

  @@index([campaignId, turnNumber])
  @@index([campaignId, targetType, targetId])
  @@index([campaignId, type])
  @@map("world_events")
}

// #101: a character's own record of which significant WorldEvents they
// actually know about, and how — the fix for fog-of-war being binary and
// campaign-wide (see visibility.ts's visibleTo()) with no way for one
// character to know something another doesn't. UNKNOWN is NOT a row here
// — see EventWitnessGrade's comment — so this table only ever grows in
// proportion to (significant events × characters who actually learned
// about them), not to campaign size.
model EventWitness {
  id           String            @id @default(cuid())
  campaignId   String
  worldEventId String
  // Exactly one of characterId/npcId is set — an app-level invariant, not
  // DB-enforced, matching this schema's own existing precedent for the
  // identical shape (PlayerNote.characterId/npcId, Quest.givenByNpcId/
  // givenByFactionId — neither is a DB CHECK either). Kept as two nullable
  // FKs rather than a generic entityType+entityId pointer specifically to
  // preserve real cascade-delete and per-kind DB-level uniqueness.
  characterId String?
  npcId       String?
  grade       EventWitnessGrade

  // Misinformation: only ever set on TOLD rows (WITNESSED = ground truth,
  // never distorted — enforced by the caller, decideDistortion is never
  // invoked for a WITNESSED write). Never mirrors into WorldEvent.reason —
  // see worldEventLog.ts's own doc comment and this system's three
  // independent ground-truth readers (the AI prompt via this table's own
  // join, historyLog.ts's RAG/CampaignMemory embeddings, and the admin
  // dashboard), none of which should ever see a distorted version.
  distorted        Boolean                 @default(false)
  distortionFlavor EventWitnessDistortion?

  // Denormalized: WorldEvent.turnNumber when grade is WITNESSED (learned
  // the instant it happened), or the tick turn tickInformation actually
  // decided this character heard about it when grade is TOLD (always
  // later than the event's own turnNumber, by the propagation delay).
  // Lets every read path (prompt capping, tickInformation's own
  // propagation-window query) sort/filter without a join back to
  // world_events for the hot path.
  turnNumber Int

  createdAt DateTime @default(now())

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  worldEvent WorldEvent @relation(fields: [worldEventId], references: [id], onDelete: Cascade)
  character  Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  npc        NPC?       @relation(fields: [npcId], references: [id], onDelete: Cascade)

  // One record per (event, character-or-npc) — what makes every insert
  // skipDuplicates-safe, and what guarantees a later TOLD pass can never
  // downgrade an existing WITNESSED row: the insert is simply skipped,
  // never an update. Two separate unique indexes (not one compound
  // [worldEventId, characterId, npcId]) because Postgres treats every NULL
  // as distinct in a unique index by default — a compound index wouldn't
  // actually dedupe NPC-only rows (characterId always NULL there) against
  // each other, but two single-column-scoped indexes each dedupe correctly
  // within their own kind.
  @@unique([worldEventId, characterId])
  @@unique([worldEventId, npcId])
  @@index([campaignId, characterId, turnNumber])
  @@index([campaignId, npcId, turnNumber])
  @@index([worldEventId])
  @@map("event_witnesses")
}

// #262: decideMigration's background-population flight fraction (distinct
// from the same function's NAMED-NPC flight path, which moves real NPC
// rows) only ever wrote the resulting LOCATION_POPULATION WorldEvent above
// — previousValue/newValue on ONE location, no record of where the people
// came from. Deliberately NOT per-person identity (this repo's stated
// design: population is "a single number" for background flavor, not a
// simulated individual) — just enough of a bounded event record, same
// shape/spirit as WorldEvent, to let future narration/simulation reference
// where a location's current population actually came from.
model PopulationFlightEvent {
  id         String   @id @default(cuid())
  campaignId String
  turnNumber Int
  createdAt  DateTime @default(now())

  fromLocationId   String
  fromLocationName String
  toLocationId     String
  toLocationName   String
  count            Int // people who fled this tick — always positive

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, turnNumber])
  @@index([campaignId, fromLocationId])
  @@index([campaignId, toLocationId])
  @@map("population_flight_events")
}

//
// RATE LIMITING
//
// Fixed-window request counters for the AI-invoking routes (see
// src/lib/rateLimit.ts). Postgres-backed rather than in-memory because the
// app deploys to serverless, where each instance has its own memory — a
// counter that only one lambda can see limits nothing. Rows are pruned
// opportunistically as new windows open.

model RateLimitCounter {
  id          String   @id @default(cuid())
  key         String // "<userId>:<bucket>"
  windowStart DateTime
  count       Int      @default(1)

  @@unique([key, windowStart])
  @@index([windowStart])
}

//
// FRIENDS SYSTEM
//

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  message    String?             @db.Text // Optional message with the request

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId])
  @@map("friend_requests")
}

model Friendship {
  id      String @id @default(cuid())
  user1Id String // Lower ID alphabetically for consistency
  user2Id String // Higher ID alphabetically

  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("friendships")
}

//
// ASYNC SCENE RESOLUTION
//
// Scene resolution (AI GM call + world turn) can take ~150s — longer than
// a request handler should live. Action submission enqueues a job here
// and returns immediately; a dedicated internal route processes it in its
// own invocation, with the existing Pusher events (scene:resolving /
// scene:resolved / scene:resolution-failed) carrying progress to the UI.
// Stale jobs are recovered opportunistically by scene GET traffic.
//

enum ResolutionJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ResolutionJob {
  id         String              @id @default(cuid())
  campaignId String
  sceneId    String
  status     ResolutionJobStatus @default(PENDING)
  attempts   Int                 @default(0)
  lastError  String?

  // Set once a global stuck-job sweep (lib/jobs/stuckJobAlert.ts) has fired
  // an alert for this job, so a dead job gets reported exactly once instead
  // of on every sweep. Cleared implicitly by the job leaving PENDING/RUNNING.
  alertedStuckAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([sceneId, status])
  @@index([campaignId, status])
}

// #96: one generated illustration per resolved scene. Combines job
// tracking and the final artifact in one row (rather than a separate job
// table + relation) — the same shape ResolutionJob would have if its
// result were a single field instead of living on Scene itself. Reuses
// ResolutionJobStatus rather than a near-duplicate enum: identical
// PENDING/RUNNING/COMPLETED/FAILED lifecycle.
//
// No @relation to Campaign/Scene, matching this codebase's existing
// convention for generated-content-per-scene rows (see ResolutionJob and
// Map above — both plain campaignId/sceneId with indexes, no FK).
// @@unique on sceneId enforces "one per scene": a second attempt after a
// failure updates the same row rather than creating a duplicate.
model SceneImage {
  id         String              @id @default(cuid())
  campaignId String
  sceneId    String              @unique
  status     ResolutionJobStatus @default(PENDING)
  // The deterministic prompt built from the scene's own text — stored so
  // a failed/retried generation, or a human looking at the admin panel,
  // can see exactly what was asked for.
  prompt     String?             @db.Text
  // The permanent Vercel Blob URL, set only once COMPLETED — never the
  // image provider's own (often short-lived) URL.
  imageUrl   String?
  attempts   Int                 @default(0)
  lastError  String?

  // Set once a global stuck-job sweep (lib/jobs/stuckJobAlert.ts) has fired
  // an alert for this job, so a dead job gets reported exactly once instead
  // of on every sweep. Cleared implicitly by the job leaving PENDING/RUNNING.
  alertedStuckAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([campaignId, status])
}

model AIValidationFailure {
  id           String   @id @default(cuid())
  campaignId   String
  sceneId      String?
  errorSummary String // Short description of what failed
  rawResponse  Json? // The AI output that failed validation
  zodErrors    Json // Serialised ZodError.errors array
  createdAt    DateTime @default(now())

  @@index([campaignId])
  @@index([createdAt])
  @@map("ai_validation_failures")
}

// A different, finer-grained tier than AIValidationFailure above.
// AIValidationFailure records the AI's whole JSON response failing Zod
// schema validation (a STRUCTURAL failure — the response didn't parse).
// StateMutation instead records what happens to an individual, structurally
// VALID field-level change once it reaches business-rule validation — e.g.
// worldUpdaters/characters.ts's relationship_changes handler resolving an
// AI-reported entity_id/entity_name against the real NPC roster. Today
// that kind of rejection is a console.warn only, gone the moment the log
// scrolls; this is the persisted, queryable version. Written BEFORE the
// validation gate decides anything, so a REJECTED row exists even when
// nothing about the AI's proposal was ever applied.
enum StateMutationResult {
  ACCEPTED
  REJECTED
  REPAIRED
}

// Closed on purpose, even with one member today — see LoreCitation's own
// note on the same discipline. Room to grow (a future deterministic tick
// handler proposing a change through the same gate, say) without ever
// becoming a free-text field no query can trust.
enum StateMutationProposer {
  AI_GM
}

model StateMutation {
  id         String   @id @default(cuid())
  campaignId String
  sceneId    String?

  proposedBy StateMutationProposer @default(AI_GM)
  // Dot-path into the entity the change targets, e.g.
  // "character.relationships.npc_abc123.trust".
  field String

  previousValue Json?
  proposedValue Json?

  result        StateMutationResult
  // Set only when result = REPAIRED — the value actually written, when it
  // differs from proposedValue (e.g. clamped, or resolved to a real id).
  repairedValue Json?
  // Human-readable reason a REJECTED/REPAIRED row exists — the same text
  // that would otherwise only ever reach a console.warn.
  reason        String?

  // Loosely coupled on purpose (no @relation), matching
  // AIValidationFailure/AnalyticsEvent/LoreCitation above: a mutation
  // record for a scene or event that's since been deleted is still real
  // history and must never fail on a constraint.
  appliedEventId String?

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([sceneId])
  @@index([campaignId, result])
  @@map("state_mutations")
}

//
// ALPHA INSTRUMENTATION (#12) — funnel/retention events
//
// A deliberately loose-coupled event log: no FK relations to User/Campaign,
// so recording an event can never fail on a constraint and a deleted
// entity's historical events still count toward that day's funnel numbers.
// See lib/analytics/events.ts for the writer and the dashboard queries.

enum AnalyticsEventType {
  SIGNUP
  CAMPAIGN_CREATED
  CHARACTER_CREATED
  SCENE_STARTED
  ACTION_SUBMITTED
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  userId     String?
  campaignId String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}
