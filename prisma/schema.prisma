generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS — must match your existing code usage
//

enum SceneStatus {
  AWAITING_ACTIONS
  RESOLVING
  RESOLVED
}

enum EventVisibility {
  PUBLIC
  GM_ONLY
  MIXED
}

enum EventType {
  SCENE
  DOWNTIME
  TIMESKIP
  WORLD_EVENT
}

enum UserRole {
  ADMIN
  PLAYER
}

// Phase 8: Communication enums
enum MessageType {
  IN_CHARACTER
  OUT_OF_CHARACTER
  WHISPER
  SYSTEM
}

enum NoteVisibility {
  PRIVATE
  GM
  SHARED
}

// Phase 9: Notification enums
enum NotificationType {
  TURN_REMINDER
  SCENE_CHANGE
  MENTION
  WHISPER_RECEIVED
  NOTE_SHARED
  CAMPAIGN_INVITE
  SCENE_RESOLVED
  AI_RESPONSE_READY
  WORLD_EVENT
  // A friend request/acceptance previously hijacked CAMPAIGN_INVITE ("no
  // FRIEND_REQUEST yet" — see notification-service.ts) which meant real
  // campaign-invite acceptance (join/[token]/route.ts) never notified
  // anyone. Splitting these frees CAMPAIGN_INVITE for its real purpose.
  FRIEND_REQUEST
  // X-Card uses previously hijacked SCENE_CHANGE ("closest existing type"
  // — see safety-service.ts) for the same reason. A dedicated type keeps
  // safety alerts distinguishable from an eventual real SCENE_CHANGE use.
  SAFETY_ALERT
  // Every CAMPAIGN_MILESTONE_INTERVAL scenes (see campaignMilestone.ts) —
  // distinct from WORLD_EVENT since a milestone is about the party's own
  // chronicle, not something that happened in the simulated world.
  CAMPAIGN_MILESTONE
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// World Sim Phase 1: deterministic tick-driven state
enum FactionGoal {
  EXPAND
  DEFEND
  ENRICH
  DESTABILIZE_RIVAL
  CONSOLIDATE
}

// World Sim Phase 2: what kind of organization a faction is, independent of
// its goal — a guild and a secret society can both pursue ENRICH, but they
// shouldn't both throw a "Grand Tournament." Drives which bounded ambition
// flavor list the offscreen AI picks from (see ambitionTick.ts).
enum FactionArchetype {
  GENERIC
  SECRET_SOCIETY
  CRIMINAL
  RELIGIOUS
  MILITARY
  CORPORATION
  POLITICAL
}

// World Sim Phase 4: an NPC's standing within a faction they're affiliated
// with (see NPC.factionRole below).
enum FactionRole {
  LEADER
  MEMBER
}

// World Sim Phase 5: see War below.
enum WarStatus {
  ESCALATING
  RESOLVED
}

enum WeatherCondition {
  CLEAR
  CLOUDY
  RAIN
  STORM
  SNOW
  FOG
}

enum WorldEventActorType {
  SYSTEM // autonomous world tick — nobody "did" this, the world just changed
  PLAYER // caused by a player action (consequence extraction)
}

enum WorldEventTargetType {
  NPC
  FACTION
  LOCATION_WEATHER
  // Added for the Integrity Engine (game/integrity/) — repairs to these
  // entity types are logged as WorldEvents the same way tick changes are.
  CLOCK
  QUEST
  WAR
  CHARACTER
  DEBT
  // #109: the DB enum value was added by migration
  // 20260802185719_location_condition_score, but this declaration was
  // missed at the time — Prisma's generated client validates enum writes
  // against THIS list, not the live Postgres type, so any WorldChange
  // tagged LOCATION_CONDITION would have failed at runtime despite the
  // column/constraint/migration all being correct. Caught while touching
  // this file for #110's LOCATION_POPULATION addition below.
  LOCATION_CONDITION
  // #110: background population shifts (tick/migrationTick.ts) are their
  // own attributable entity type, distinct from conditionScore drift.
  LOCATION_POPULATION
  // #175: a location's own descriptive fields (description, locationType,
  // corruption gates, discovery) changing during scene resolution —
  // distinct from the three tick-specific sub-concerns above.
  LOCATION
}

// #101: a character's own record of a significant WorldEvent — WITNESSED
// (present when it happened, 100% accurate) or TOLD (heard secondhand,
// rumor-grade). UNKNOWN is deliberately NOT a value here: it's the
// absence of an EventWitness row, not a third state, since a row per
// (event, character) for every character on every event would be
// O(events × characters) — see EventWitness's own comment.
enum EventWitnessGrade {
  WITNESSED
  TOLD
}

// Misinformation: only ever set on TOLD rows — WITNESSED means present
// when it happened, ground truth, never distorted. Whether a specific
// witness's own account of an event is wrong, and how. Deliberately a
// small fixed set of narrative flavors, not free text — see
// decideDistortion's own doc comment (informationTick.ts) for why: this
// stays a deterministic tick "roll" (stableHash, no AI call) that the
// already-running AI GM turns into prose at narration time, the same way
// the existing Witnessed:/Heard secondhand: prompt lines are framing
// instructions rather than pre-baked text.
enum EventWitnessDistortion {
  EXAGGERATED
  MINIMIZED
  GARBLED_DETAIL
  ATTRIBUTED_WRONG
}

//
// USER & MEMBERSHIP
//

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Payment system - balance stored in cents (e.g., 100 = $1.00)
  balance Int @default(0)

  // Account security: email verification + password reset.
  // Tokens are UUIDs looked up via findFirst on plain indexes — not
  // @unique, because prisma db push conservatively flags adding a unique
  // constraint as potential data loss and fails the deploy guardrail.
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  resetToken        String?
  resetTokenExpires DateTime?

  // Session revocation (#98). Tokens are stateless JWTs with a long life,
  // so before this there was NO way to invalidate one: a leaked token
  // stayed valid until it expired, and changing a password did nothing to
  // sessions already open. Every token carries the version it was minted
  // at; bumping this invalidates all of them at once.
  //
  // Defaulted rather than required so the migration is purely additive —
  // existing rows get 0, and tokens minted before this existed carry no
  // version and are accepted (see isTokenRevoked). Logging out the entire
  // userbase to ship a security improvement would be its own outage.
  tokenVersion Int @default(0)

  // Phase 9: Online status
  lastSeenAt DateTime?
  isOnline   Boolean   @default(false)

  campaignMemberships CampaignMembership[]
  characters          Character[]
  playerActions       PlayerAction[]
  createInvites       CampaignInvite[]     @relation("InviteCreator")
  diceRolls           DiceRoll[]
  gmClarifications    GmClarification[]

  // Phase 8: Communication
  sentMessages     Message[]    @relation("UserMessages")
  receivedWhispers Message[]    @relation("UserWhispers")
  notes            PlayerNote[] @relation("UserNotes")

  // Phase 9: Notifications
  notifications        Notification[]            @relation("UserNotifications")
  notificationSettings UserNotificationSettings? @relation("UserNotificationSettings")
  pushSubscriptions    PushSubscription[]        @relation("UserPushSubscriptions")

  @@index([emailVerifyToken])
  @@index([resetToken])
}

model CampaignMembership {
  id           String    @id @default(cuid())
  userId       String
  campaignId   String
  role         UserRole  @default(PLAYER)
  joinedAt     DateTime  @default(now())
  // Last time this member loaded the campaign lobby page — the checkpoint
  // "While you were away" recaps diff offscreen fallout against. Null means
  // they've never landed on the lobby yet (no recap to show).
  lastViewedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
}

//
// CAMPAIGN ROOT
//

model Campaign {
  id               String   @id @default(cuid())
  title            String
  description      String?
  universe         String?
  aiSystemPrompt   String   @db.Text
  initialWorldSeed String   @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Read-only public share link for the story log — off by default (a GM
  // opts in from the admin Settings tab). The token is only set once
  // enabled; disabling clears it rather than just flipping the flag, so a
  // previously-shared link can't be silently re-enabled by guessing state.
  chronicleShareEnabled Boolean @default(false)
  chronicleShareToken   String? @unique

  // Player-text input moderation strictness (see lib/ai/moderation.ts).
  // "standard" (default) doesn't block plain violence — expected content
  // in a combat RPG. "strict" blocks everything OpenAI's moderation
  // endpoint flags, for campaigns that want a tighter filter.
  contentModerationLevel String @default("standard")

  // Fiction-flavored display names for the 5 fixed PbtA stat keys
  // (cool/hard/hot/sharp/weird — see lib/pbta-moves.ts), generated once at
  // campaign creation alongside the capability scaffold (see
  // lib/ai/worldGenerator.ts). Null falls back to the generic PBTA_STATS
  // labels. Only the label changes — the underlying keys and resolution
  // math are the same for every campaign.
  // Shape: Record<'cool'|'hard'|'hot'|'sharp'|'weird', { label: string; description: string }>
  statLabels Json?

  // Corruption track theme — what "power at a cost" means in THIS
  // universe, generated at creation (see lib/ai/worldExtras.ts). Defined
  // by the fiction's own devil's bargain, never by aesthetics; null means
  // this universe has no such concept and the track is disabled entirely.
  // Shape: { name, description, stages: string[5], bargainGuidance }
  corruptionTheme Json?

  // In-fiction calendar structure (month names/lengths, weekday names,
  // starting year) — generated once at creation (see
  // lib/ai/calendarGenerator.ts), immutable afterward, same
  // generated-once-then-frozen pattern as statLabels/corruptionTheme
  // above. Null only for campaigns created before this existed; the next
  // scene resolution for one of those lazily backfills a real generated
  // calendar (see lib/game/calendarBackfill.ts) rather than leaving it
  // permanently null. Never read directly for display — always through
  // formatInGameDate (lib/game/calendar.ts), falling back to
  // DEFAULT_CALENDAR while null.
  // Shape: GeneratedCalendar (lib/game/calendar.ts)
  calendarConfig Json?

  // Integrity Engine Phase 4 — universe-scoped semantic invariants. The
  // catalogue of check families this can activate is closed and hard-coded
  // (game/integrity/worldRules.ts); the AI only picks WHICH families apply
  // to this universe and with what confidence, generated at reseed time
  // (lib/ai/worldRulesGenerator.ts) the same way corruptionTheme is — never
  // a free-form predicate. Null (the default) means every semantic check
  // behaves exactly as it did before this column existed: absence is
  // always a safe state here, same as corruptionTheme.
  // Shape: { rules: WorldRule[] } (game/integrity/worldRules.ts)
  worldRules Json?

  // True while a creation-time lore import + auto-reseed is in flight —
  // the campaign is unplayable (no characters, no scenes) until the world
  // has finished becoming its canon self, so a mid-import character can't
  // flip the reseed into additive mode. Cleared by the worker when the
  // reseed finishes (or the import permanently fails), with a stale-flag
  // self-heal in lib/lore/seedingGate.ts so a dead worker can never lock
  // a campaign forever.
  pendingWorldSeed Boolean @default(false)

  // Battle-map generation (see lib/ai/ai-visual-service.ts). Off by
  // default and opt-in per campaign: every qualifying scene resolution
  // otherwise makes a second AI call and writes a fresh batch of
  // zones/tokens, which is real recurring cost for a feature many
  // campaigns never look at. Existing campaigns default off too — a
  // campaign that wants maps turns them on once from the admin panel,
  // which is a cheaper mistake than silently billing every campaign for
  // something unused. See README Known Bugs (#9, #59).
  mapGenerationEnabled Boolean @default(false)

  // #96: AI-generated scene illustration, one image per resolved scene.
  // Off by default and opt-in per campaign, same reasoning as
  // mapGenerationEnabled directly above — real recurring image-generation
  // cost that many campaigns won't want paid for every scene by default.
  sceneImageGenerationEnabled Boolean @default(false)

  // Campaign lobby hero banner image: generated exactly ONCE per campaign,
  // fire-and-forget at creation (campaignCreation.ts) — not opt-in, unlike
  // the two recurring-cost toggles above, since this is a single flat
  // ~$0.04 cost in the same order of magnitude as the calendar/world-rules
  // generation every campaign already gets unconditionally. NONE (never
  // attempted or no API key) / PENDING / READY / FAILED; heroImageUrl is
  // only ever read when status is READY.
  heroImageUrl    String?
  heroImageStatus String  @default("NONE")

  // #13 first-party templates: which static template (campaign-templates.ts)
  // this campaign was created from, if any — a compile-time id, not a DB
  // relation, since templates are TypeScript objects. Lets a template's
  // startingDebtTemplates be applied when each character joins (Debt rows
  // need a real characterId, which doesn't exist yet at campaign creation).
  templateId String?

  memberships      CampaignMembership[]
  characters       Character[]
  npcs             NPC[]
  factions         Faction[]
  locations        Location[]
  clocks           Clock[]
  scenes           Scene[]
  timeline         TimelineEvent[]
  worldMeta        WorldMeta?
  invites          CampaignInvite[]
  moves            Move[]
  diceRolls        DiceRoll[]
  gmClarifications GmClarification[]
  aiCostEntries    AICostEntry[]

  // Phase 8: Communication
  messages Message[]    @relation("CampaignMessages")
  notes    PlayerNote[] @relation("CampaignNotes")

  // Phase 9: Notifications
  notifications Notification[] @relation("CampaignNotifications")
  turnTracker   TurnTracker[]  @relation("CampaignTurnTracker")

  // Campaign Memory (RAG System)
  memories CampaignMemory[]

  // World Sim: persisted event stream
  worldEvents WorldEvent[]
  populationFlightEvents PopulationFlightEvent[]
  eventWitnesses EventWitness[]

  // World Sim Phase 5: sustained multi-turn conflicts between factions.
  wars War[]

  // Knowledge-relative capabilities: this universe's latent systems
  // (magic schools, fighting styles, political arts...) that characters
  // discover and grow into through the fiction.
  capabilities CampaignCapability[]

  // Urban Shadows economy: owed favors between PCs and NPCs/factions.
  debts Debt[]

  // #103: institutional-memory wake effects from a death/collapse.
  activeWakes ActiveWake[]

  // #106: flat supply routes between two of this campaign's locations.
  supplyRoutes SupplyRoute[]

  // #108: flat adjacency edges between two of this campaign's locations.
  locationAdjacencies LocationAdjacency[]

  // #111: faction-to-faction economic obligations.
  factionDebts FactionDebt[]

  // #119: generic signed/contested-value arcs (territory loyalty, and any
  // future consumer).
  arcs Arc[]

  // Urban Shadows economy: per-character social position with factions.
  factionStandings FactionStanding[]

  // Lore import: pasted text / URLs / wiki crawls, chunked and embedded for
  // the AI GM to draw on during play (see lib/lore, lib/ai/loreRetrieval.ts).
  loreImportJobs LoreImportJob[]
  loreEntries    LoreEntry[]

  // World reseed: regenerating world structure from imported lore runs
  // off the request path too (see lib/lore/reseedQueue.ts) — a large
  // corpus makes two sequential AI calls that can outrun a single
  // serverless invocation's time budget.
  reseedJobs ReseedJob[]

  // Quest tracking: named objectives the AI GM opens/progresses/closes
  // through play (quest_changes in world_updates — see lib/game/stateUpdater.ts).
  quests Quest[]

  // Playbook onboarding: 3-5 ready-to-play character archetypes generated
  // for this universe at creation (see lib/ai/worldExtras.ts).
  archetypes CampaignArchetype[]
}

//
// ORIGIN ARCHETYPES — per-universe playbook cards for fast character
// creation. Picking one pre-fills the creation wizard (stats, gear,
// familiarity) and seeds starting ties (a Debt or faction standing) plus
// extra capability glimpses server-side. Purely optional — the blank
// wizard still works, and a campaign whose generation failed simply has
// no cards.
//

model CampaignArchetype {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String // "Newly Awakened Outworlder"
  description String @db.Text // 1-2 sentence pitch shown on the card

  originFamiliarity     OriginFamiliarity @default(NATIVE)
  // Valid PbtA stat array (sum +2, each -2..+3, at most one >= +2) keyed by
  // the 5 fixed stat keys; null = leave the wizard's defaults alone.
  suggestedStats        Json?
  // { weapon, armor, misc, items: [{ name, quantity, tags }] }
  startingGear          Json?
  // One starting tie into the living world:
  // { kind: 'debt_owed_by_character' | 'debt_owed_to_character' | 'faction_standing',
  //   counterparty_type: 'npc' | 'faction', counterparty_name, description, standing_value? }
  startingTie           Json?
  // Questions shown as backstory guidance when the card is picked.
  backstoryPrompts      String[]          @default([])
  // CampaignCapability keys to seed as GLIMPSED on top of familiarity seeding.
  glimpseCapabilityKeys String[]          @default([])

  createdAt DateTime @default(now())

  @@index([campaignId])
}

//
// QUESTS — named objectives with a lifecycle, tracked from the fiction.
// The AI GM registers a quest when an NPC/faction gives the party a job,
// appends progress beats as scenes resolve, and closes it when the fiction
// settles it. Synced to the wiki's QUEST tab (see sceneResolver.ts).
//

enum QuestStatus {
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED
}

model Quest {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name             String
  description      String   @db.Text
  objective        String?  @db.Text // what "done" looks like, in-fiction
  // Stable slug of the quest's name, unique per campaign (#45). The handle
  // other content refers to a quest BY — free-text names drift as the
  // fiction re-phrases them, so "this unlocks after the ledger job" needs
  // something that doesn't. Derived deterministically at creation; see
  // questObjectiveKey in lib/game/quests.ts.
  objectiveKey     String?
  givenBy          String? // NPC or faction name that issued it (free text)
  // Resolved quest-giver (#75). givenBy stays the authoritative display
  // string — same free-text-plus-nullable-FK pattern as
  // Character.currentLocation/locationId — but these are what make the
  // giver a real entity: without them "the quest-giver remembers you
  // failed" is unrepresentable, because a name string can't be queried
  // back to the NPC who is standing in front of you. At most one is set.
  // SetNull, not Cascade: a dead NPC's quest still exists, it just no
  // longer has a living giver.
  givenByNpcId     String?
  givenByNpc       NPC?     @relation("QuestGiverNpc", fields: [givenByNpcId], references: [id], onDelete: SetNull)
  givenByFactionId String?
  givenByFaction   Faction? @relation("QuestGiverFaction", fields: [givenByFactionId], references: [id], onDelete: SetNull)
  reward           String? // what was promised, if anything (free text)

  // Corruption gate (#83). min = only the marked may pass; max = the
  // marked are turned away. Null on both (the default) means ungated.
  // Enforced at a BOUNDARY only — never re-evaluated against state a
  // character already holds — because marks are irreversible and a
  // retroactive gate would be a one-way trap. See lib/game/corruptionGates.ts.
  // Checked on ACQUISITION: an already-active quest is never revoked and
  // completion is never blocked. Corruption can stop you taking a job; it
  // must not strand you mid-job.
  minCorruption Int?
  maxCorruption Int?

  status      QuestStatus @default(ACTIVE)
  // Appended narrative beats, newest last — "Turn 4: found the smuggler's ledger"
  progressLog String?     @db.Text

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  // Was indexed-only, not unique: this project's build command used to be
  // `prisma db push`, and Prisma classifies adding a unique constraint as a
  // potentially-destructive change it refuses without --accept-data-loss.
  // The build now runs `prisma migrate deploy` instead, so that restriction
  // no longer applies (Phase 1b) — real enforcement is the unique index
  // added by migration 20260729030000_phase1b_schema_invariants
  // (Quest_campaignId_objectiveKey_key, replacing this index; NULLs stay
  // distinct from each other under a unique index, so multiple unkeyed
  // quests per campaign are still fine). claimObjectiveKey
  // (worldUpdaters/quests.ts) still only claims a key no other quest holds
  // first — the constraint is a backstop against the narrow check-then-act
  // race that check has, not the primary defense — and the create call now
  // catches a unique-violation and leaves the quest unkeyed rather than
  // aborting the whole scene-resolution transaction.
  @@unique([campaignId, objectiveKey], map: "Quest_campaignId_objectiveKey_key")
  @@index([campaignId, status])
  @@index([givenByNpcId])
  @@index([givenByFactionId])

  // Real name uniqueness enforced by a case-insensitive functional index
  // (same migration) — see NPC's identical comment for why this can't be a
  // plain Prisma @@unique.
}

//
// CAPABILITIES (knowledge-relative character sheets)
//
// A real prerequisite tree (#82). parentId/children sat here unread and
// unwritten for a long time, implying a feature that didn't exist; it is
// now built rather than dropped. World generation declares each deeper art's
// prerequisite by name, and a node whose parent the character has not
// UNLOCKED cannot itself be unlocked — the attempt downgrades to a glimpse,
// exactly like the shadow/corruption gate. See prerequisiteUnlockBlocked in
// lib/game/capabilities.ts. `tier`, `isSecret` and `isShadow` + corruption
// still gate independently; the tree is an additional axis, not a
// replacement, and a campaign whose generation produced no prerequisites is
// simply a forest of roots that behaves exactly as before.
//
// The universe has a latent tree of learnable systems. What a character
// SEES of that tree depends on what the fiction has shown them:
//   no row      -> the character doesn't know this exists (sheet: absent)
//   GLIMPSED    -> they know it exists but can't do it (sheet: "???" + hint)
//   UNLOCKED    -> they have it; hidden proficiency grows with use/training
// Raw proficiency numbers never leave the server — players only ever see
// qualitative bands (see proficiencyBand in lib/game/capabilities.ts).
//

enum CapabilityState {
  GLIMPSED
  UNLOCKED
}

// How familiar a character is with this universe's systems at creation.
// Drives initial discovery seeding, not power level: a NATIVE knows the
// scaffold of what exists; an OUTSIDER starts with a nearly blank sheet.
enum OriginFamiliarity {
  NATIVE
  NEWCOMER
  OUTSIDER
}

model CampaignCapability {
  id          String   @id @default(cuid())
  campaignId  String
  key         String // stable slug, e.g. "dark-essence"
  name        String
  description String?
  domain      String // top-level grouping, e.g. "Essence Magic", "Swordplay"
  tier        Int      @default(1)
  // Secret branches are hidden even from natives until the fiction
  // reveals them (forbidden schools, lost arts).
  isSecret    Boolean  @default(false)
  // Shadow branch: unlockable only through corruption marks (unlock
  // requires corruption >= tier — see lib/game/capabilities.ts). Set at
  // generation time ONLY for campaigns with a corruption theme; distinct
  // from isSecret because mid-story is_new nodes are born secret without
  // being forbidden.
  isShadow    Boolean  @default(false)
  // Prerequisite: the node that must be UNLOCKED before this one can be.
  // Null for roots, which is every node in a campaign generated without
  // prerequisites. onDelete: SetNull rather than Cascade — deleting a
  // prerequisite must orphan its children into roots, never delete the
  // deeper arts along with it.
  parentId    String?
  createdAt   DateTime @default(now())

  campaign        Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parent          CampaignCapability?   @relation("CapabilityTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        CampaignCapability[]  @relation("CapabilityTree")
  characterStates CharacterCapability[]

  @@unique([campaignId, key])
  @@index([campaignId])
  @@index([parentId])
}

//
// DEBTS (Urban Shadows economy)
//
// A Debt is one owed favor between a player character and an NPC or
// faction, in either direction. It's the AI GM's currency for
// consequences and leverage: incurred when the fiction earns it, called
// in later as pressure, resolved when honored (or refused — which has its
// own costs). Rendered diegetically on the sheet ("Lord Kessler considers
// you in his debt"), never as a ledger counter.
//

enum DebtDirection {
  OWED_BY_CHARACTER // the PC owes the counterparty
  OWED_TO_CHARACTER // the counterparty owes the PC
}

enum DebtStatus {
  OUTSTANDING
  RESOLVED
}

model Debt {
  id          String @id @default(cuid())
  campaignId  String
  characterId String

  direction        DebtDirection
  counterpartyType String // "npc" | "faction"
  // Resolved entity id when the name matched a known NPC/faction; the
  // denormalized name is authoritative for display either way.
  counterpartyId   String?
  counterpartyName String

  description String // what the favor was — the fiction that created it
  status      DebtStatus @default(OUTSTANDING)
  resolution  String? // how it ended (honored, refused, forgiven...)

  turnCreated  Int       @default(0)
  turnResolved Int?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([characterId, status])
}

//
// FACTION STANDING (Urban Shadows economy)
//
// A character's social position with a faction, -3 (hunted/hated) to +3
// (honored/inner circle). Shifts come from scene outcomes; mechanical
// WEIGHT reads live simulation state at roll time (standing with a
// collapsed faction is worthless, with a war-weakened one worth less) —
// this is how the offscreen tick changes what a player can roll without
// the tick writing standing rows. See lib/game/standing.ts.
//

model FactionStanding {
  id          String @id @default(cuid())
  campaignId  String
  characterId String
  factionId   String
  value       Int    @default(0) // -3..+3 — DB CHECK FactionStanding_value_range (Phase 1b)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  faction   Faction   @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([characterId, factionId])
  @@index([campaignId])
}

model CharacterCapability {
  id           String          @id @default(cuid())
  characterId  String
  capabilityId String
  state        CapabilityState @default(GLIMPSED)
  proficiency  Int             @default(0) // 0-100, hidden from players
  // The character's own vocabulary for this capability while they lack
  // the local frame ("Earth sword forms" before learning local styles).
  framedLabel  String?
  hint         String? // shown on "???" (glimpsed) sheet entries
  source       String? // the fiction that revealed/unlocked it
  usageCount   Int             @default(0)
  // Per-arc growth guardrail (see ARC_LENGTH_TURNS / MAX_GROWTH_PER_ARC).
  growthInArc  Int             @default(0)
  arcStartTurn Int             @default(0)
  unlockedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  character  Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  capability CampaignCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([characterId, capabilityId])
  @@index([characterId])
}

//
// CHARACTERS
//

model Character {
  id              String    @id @default(cuid())
  campaignId      String
  userId          String
  name            String
  pronouns        String?
  description     String?
  appearance      String? // Physical appearance
  personality     String? // Personality traits and demeanor
  stats           Json? // For PbtA: {cool: 1, hard: 2, hot: -1, sharp: 1, weird: 0}
  backstory       String?
  goals           String?
  isAlive         Boolean   @default(true)
  // currentLocation is still the source of truth the AI/creation form
  // write directly (free text) — locationId is a nullable FK alongside it,
  // resolved via the same exact-name-match Location already keys on
  // (campaignId+name), so location-identity comparisons (weather, split-
  // party grouping) can join on a stable id instead of raw string equality.
  // See README Known Bugs P1 — Location stored as free text, not an FK.
  currentLocation String?
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  gmNotes         String?

  // Knowledge-relative sheet: how familiar this character is with the
  // universe's systems at creation (drives capability discovery seeding).
  originFamiliarity OriginFamiliarity @default(NATIVE)

  // PbtA specific fields
  harm           Int   @default(0) // 0-6 harm track — DB CHECK Character_harm_range (Phase 1b)
  // Corruption marks (0..5) toward this campaign's corruption theme.
  // Only meaningful when Campaign.corruptionTheme is set; never decreases
  // (the whole point is irreversibility) — see lib/game/corruption.ts.
  corruption     Int   @default(0) // 0-5 — DB CHECK Character_corruption_range (Phase 1b)
  // Accumulated psychological pressure (0-10) — unlike corruption, this
  // RECOVERS: it decays on a scene with no stress-raising event, rather
  // than only ever climbing. Drifted server-side in worldUpdaters/
  // characters.ts from signals already present in that same apply pass
  // (a miss, real harm taken, a costly consequence, a corruption mark) —
  // never a field the AI reports directly, same "engine decides" boundary
  // dice/corruption already keep. Fully hidden — not even a qualitative
  // band on the sheet the way capability proficiency gets one, since
  // showing it would turn "did I fail?" into "am I about to level up,"
  // exactly the gaming-the-meter problem Character.relationships is
  // already hidden to avoid. See lib/game/stress.ts. The only player-
  // facing surface is the eventual evolution offer itself (advancement.ts),
  // framed diegetically, never as a number.
  stress         Int   @default(0) // 0-10 — DB CHECK Character_stress_range
  // An open corruption bargain narrated to this character last scene —
  // their NEXT action can invoke it for an engine-enforced surge bonus
  // (and the mark). Cleared after that action, accepted or not.
  // Shape: { offer: string, offeredTurn: number }
  pendingBargain Json?
  conditions     Json? // { conditions: [{ id, name, category, description, mechanicalEffect?, appliedAt? }] }
  // Structured, permanent declarative knowledge (#173/#174) — "the
  // character knows X," distinct from conditions (temporary present-tense
  // state) and from CharacterCapability (system existence + this
  // character's proficiency in it, an entirely separate dimension). See
  // lib/game/knowledge.ts. Shape: { concepts: [{ key, label, learnedAt,
  // source? }] }. RAG (CampaignMemory/LoreEntry) still answers "when/how
  // did they learn this" — this answers "do they currently know this."
  knownConcepts  Json?
  moves          Json? // [{ id, name, trigger, description }] — rare, narratively-earned signature tricks (see lib/game/advancement.ts). Distinct from capabilities (skill-tree systems) and perks (repeated-pattern bonuses).

  // Organic growth tracking
  statUsage      Json? // { [statKey: string]: { uses: Int, successes: Int, failures: Int, lastGrowthTurn?: Int } } — lastGrowthTurn gates re-proposing a +1 within the same arc (see ARC_LENGTH_TURNS in lib/game/capabilities.ts)
  perks          Json? // [{ id, name, description, tags? }]
  advancementLog Json? // { entries: [], totalStatIncreases, totalPerksGained, totalMovesLearned }

  // #214: optimistic-concurrency guard for applyOrganicCharacterGrowth
  // (sceneResolver.ts) — that write reads this character once, computes the
  // whole statUsage/stats/perks/moves/advancementLog update from that
  // snapshot, and writes it back OUTSIDE the pc_changes transaction with no
  // lock. Two overlapping scene resolutions for the same character used to
  // both read the same stale advancementLog, both see arc budget available,
  // and the second write would silently clobber the first. The write now
  // goes through updateMany guarded on (id, advancementVersion) + an atomic
  // increment — only the transaction that still finds the version it read
  // wins; the loser's growth for that call is skipped, not double-applied.
  advancementVersion Int @default(0)

  // Inventory and equipment
  inventory Json? // { items: [{ id, name, quantity?, tags? }], slots?: number }
  equipment Json? // { weapon?: {...}, armor?: {...}, misc?: [...] }
  resources Json? // { gold?: number, reputation?: { [factionId: string]: number }, contacts?: string[] }

  // Phase 14: Relationships and consequences (HIDDEN from players)
  //
  // #91 is DECIDED: these stay hidden. The numbers drive a real roll
  // modifier (relationshipModifier in lib/game/resolution.ts), and that is
  // exactly why showing them would be wrong — a visible meter turns a
  // relationship into a resource to farm, and players optimise a number
  // they can see. What a character has earned reaches them through the
  // fiction and through the receipt's diegetic phrasing ("they trust you",
  // "word travels in your favor"), never as trust: 62.
  //
  // Deliberately NOT the same call as capability proficiency, which is
  // hidden as a raw number but surfaced as a qualitative band: a
  // proficiency band describes the character's own competence, which they
  // would plausibly know, while rapport is someone else's private opinion
  // of them.
  relationships Json? // { [entityId: string]: { trust: Int, tension: Int, respect: Int, fear: Int } }
  consequences  Json? // { promises?: string[], debts?: string[], enemies?: string[], longTermThreats?: string[] }

  // Abstract range band within the current scene: how far this character
  // stands from the center of the action ("close" | "near" | "far" |
  // "distant"). Read by computeMechanics via rangeModifier — melee wants to
  // be close, ranged wants a middle distance — so position is a real roll
  // modifier on the DiceRoll receipt, not flavor. See lib/game/zones.ts.
  //
  // Distinct from, and never reconciled with, the literal x/y Map/Zone/
  // Token grid: that one draws battle maps, this one prices rolls. Null
  // means DEFAULT_ZONE.
  currentZone  String?
  // { sceneId?: string, note?: string } — sceneId is what scopes a position
  // to its scene without a hook in scene creation: a zone stored under a
  // different scene is stale by definition and resolves back to the default
  // on read. note is the fiction's own words for where they are, carried
  // into the narration prompt.
  zoneMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerActions    PlayerAction[]
  diceRolls        DiceRoll[]
  gmClarifications GmClarification[]

  // Phase 8: Communication
  messages Message[]    @relation("CharacterMessages")
  notes    PlayerNote[] @relation("CharacterNotes")

  // World Sim Phase 6: factions this PC leads (see Faction.leaderCharacterId).
  ledFactions Faction[] @relation("FactionPCLeader")

  // Knowledge-relative sheet: what this character knows of / can do with
  // the universe's capability tree.
  capabilities CharacterCapability[]

  // Urban Shadows economy: this PC's owed favors, both directions.
  debts Debt[]

  // Urban Shadows economy: social position with each faction (-3..+3).
  factionStandings FactionStanding[]

  // #101: this character's own record of which significant WorldEvents
  // they actually know about (WITNESSED vs. TOLD) — see EventWitness.
  eventWitnesses EventWitness[]

  @@index([campaignId])
  @@index([userId])
  @@index([locationId])
}

//
// NPCs & FACTIONS
//

model NPC {
  id              String    @id @default(cuid())
  campaignId      String
  name            String
  pronouns        String?
  description     String?
  // See Character.currentLocation/locationId's doc comment — same pattern.
  currentLocation String?
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  goals           String?
  relationship    String?
  isAlive         Boolean   @default(true)
  importance      Int       @default(1)
  gmNotes         String?

  // Minimal harm tracking (depth-hardening item-scope follow-up — see
  // README), mirroring Character.harm's 0-6 track but without the fuller
  // PC machinery (conditions/death-saves/permanent-injury): a weapon's
  // damage only has somewhere honest to land if the target it's dealt to
  // can actually take damage. stateUpdater.ts applies npc_changes'
  // harm_damage here via the same applyHarm() PCs use, and flips isAlive
  // false at 6 (Taken Out) — never flips it back true; NPC "recovery" is
  // narrative, not tracked.
  harm Int @default(0) // 0-6 — DB CHECK NPC_harm_range (Phase 1b)

  // Fog of war: defaults true so existing/starting-world NPCs and any NPC
  // the AI introduces mid-scene (which is itself the discovery event) stay
  // visible without extra steps. Set false to build an NPC into the world
  // as background lore before the party has any in-fiction way to know
  // about them — see stateUpdater.ts for how it flips back to true, and
  // worldState.ts for where undiscovered NPCs are excluded from the
  // player-facing AI prompt entirely.
  isDiscovered Boolean @default(true)

  // World Sim Phase 1: deterministic tick behavior for major NPCs (importance >= 4)
  currentPlan  String?
  // World Sim Phase 2: how far a major NPC has progressed toward their
  // current `goals` text (0-100). Advances deterministically each tick;
  // reaching 100 completes the goal, emits a MAJOR world event, and clears
  // back to 0 awaiting a new goal (set by the AI via world_updates).
  goalProgress Int     @default(0)

  // PbtA fields for significant NPCs
  threat   String? // Type of threat (warlord, grotesque, landscape, etc)
  impulses String[] // What drives this NPC
  moves    String[] // Custom moves this NPC can trigger

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Phase 8: Communication
  notes PlayerNote[] @relation("NPCNotes")

  // #101: this NPC's own record of which significant WorldEvents it
  // actually knows about (TOLD only — see EventWitness's own comment for
  // why NPCs never get WITNESSED in this pass).
  eventWitnesses EventWitness[]

  // World Sim Phase 4: this NPC's affiliation with a faction, if any — gives
  // a faction actual subjects instead of just abstract stats. A LEADER's
  // death triggers automatic succession (see npcTick.ts); a MEMBER can
  // defect if their faction collapses (see factionTick.ts).
  factionId   String?
  factionRole FactionRole?
  faction     Faction?     @relation("FactionMembers", fields: [factionId], references: [id], onDelete: SetNull)

  // NPC motivation model: how this NPC's individual disposition has drifted
  // based on what's actually happened TO them (and to their faction) —
  // closed 3-axis schema (selfPreservation, loyalty, ambition, each 0-100),
  // parsed via parseDisposition (tick/npcDispositionTick.ts) with the same
  // validate-on-read/null-on-malformed convention as parseBeliefVector.
  // Never exposed to the AI prompt — same boundary Faction.beliefVector
  // already draws. Null until the first real drift event writes it;
  // consumers fall back to a neutral (50/50/50) default when null.
  disposition Json?

  // Phase 9: NPC society — individual-level relationships between major
  // NPCs, derived from faction affiliation (same faction = ALLY; rival/ally
  // factions per Faction.relationships = inherited). Shape mirrors
  // Faction.relationships: Record<otherNpcId, { type: 'RIVAL' | 'ALLY';
  // since: number }>. Written by npcSocietyTick.ts; distinct from the
  // `relationship` field above, which is this NPC's stance toward the
  // PLAYER CHARACTERS, not toward other NPCs.
  socialTies Json?

  // Corruption gate (#83). min = only the marked may pass; max = the
  // marked are turned away. Null on both (the default) means ungated.
  // Enforced at a BOUNDARY only — never re-evaluated against state a
  // character already holds — because marks are irreversible and a
  // retroactive gate would be a one-way trap. See lib/game/corruptionGates.ts.
  // Checked on LEVERAGE: a repulsed NPC's rapport doesn't modify the roll
  // while the gate applies, and helps again the moment it stops. No
  // lasting state, so nothing to trap.
  minCorruption Int?
  maxCorruption Int?

  // Quests this NPC personally handed out (#75). The reason the FK exists:
  // it's what lets a FAILED quest reach back to the person who gave it.
  questsGiven Quest[] @relation("QuestGiverNpc")

  // Real uniqueness enforced by a case-insensitive functional index
  // (migration 20260729030000_phase1b_schema_invariants) — not expressible
  // as a Prisma @@unique, which can't target lower(name). Case-insensitive
  // to match how every write path already resolves names
  // (entityResolution.ts's normalizeEntityName); a case-SENSITIVE
  // constraint would just reproduce Location's own known bug (its
  // @@unique([campaignId, name]) is case-sensitive while every writer
  // matches insensitively, which has already caused split rows there).
  @@index([campaignId])
  @@index([factionId])
  @@index([locationId])
}

model Faction {
  id            String   @id @default(cuid())
  campaignId    String
  name          String
  description   String?
  goals         String?
  resources     Int      @default(50)
  influence     Int      @default(50)
  currentPlan   String?
  threatLevel   Int      @default(1)
  // World Sim Phase 3: written and read by relationshipTick.ts. Shape:
  // Record<otherFactionId, { type: 'RIVAL' | 'ALLY'; since: number }>.
  // Absence of an entry for a given faction means NEUTRAL. Recomputed each
  // tick from both factions' goals/stability, so it evolves on its own as
  // circumstances change rather than being a one-time GM-authored fact.
  relationships Json?
  gmNotes       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // World Sim Phase 1: the 4 tracked simulation fields tick logic reads/writes.
  // Added alongside the legacy fields above rather than renaming them (decided
  // 2026-07-08) - influence/threatLevel/currentPlan stay as-is for existing
  // narration code; `goals` (plural) also stays as flavor text.
  stability Int         @default(50)
  military  Int         @default(50)
  goal      FactionGoal @default(CONSOLIDATE)

  // World Sim Phase 2: see FactionArchetype above.
  archetype FactionArchetype @default(GENERIC)

  // #104: how this faction's outward disposition has drifted based on what's
  // actually happened to it — closed 4-axis schema (aggression, isolationism,
  // mercantilism, zealotry, each 0-100), parsed via parseBeliefVector
  // (tick/beliefTick.ts) with the same validate-on-read/null-on-malformed
  // convention as parseCorruptionTheme/parseWorldRules. Null until the first
  // real drift event writes it — decideFactionGoalReassessment and
  // decideBeliefDrift both fall back to a neutral (50/50/50/50) default when
  // this is null, so an unset vector is never treated as zero or missing data.
  beliefVector Json?

  // Fog of war: defaults true so existing/starting-world factions and any
  // faction the AI registers mid-scene (the registration IS the discovery
  // event) stay visible without extra steps. Set false to build a faction
  // into the world as background lore/antagonist scheming before the party
  // has any in-fiction way to know it exists — flips back to true only
  // when a *live scene* touches it (see stateUpdater.ts's sceneOrigin
  // param), never from an offscreen background event, so the party can't
  // learn about a hidden faction just because the simulation moved it.
  isDiscovered Boolean @default(true)

  // World Sim Phase 3: false once a faction has collapsed (stability
  // bottomed out) — absorbed by a rival or disbanded into a successor. Kept
  // as a row instead of deleted so its history stays queryable. Excluded
  // from all tick processing once false.
  isActive Boolean @default(true)

  // World Sim Phase 6: set when a player character leads this faction
  // rather than an NPC. A player-led faction still ticks like any other
  // (stats drift, ambitions can trigger, wars can happen) but its `goal`
  // is never overwritten by the automatic reassessment in factionTick.ts —
  // the player's own strategic choice sticks, set through scene
  // resolution's world_updates (see stateUpdater.ts) or the admin panel.
  // At most one leader either way: assigning a PC leader demotes any
  // existing NPC LEADER on this faction to MEMBER.
  leaderCharacterId String?
  leaderCharacter   Character? @relation("FactionPCLeader", fields: [leaderCharacterId], references: [id], onDelete: SetNull)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Phase 8: Communication
  notes PlayerNote[] @relation("FactionNotes")

  // World Sim Phase 2: clocks this faction autonomously spawned while
  // pursuing an ambitious goal (e.g. a tournament, a campaign of conquest).
  spawnedClocks Clock[] @relation("FactionSpawnedClocks")

  // World Sim Phase 3: DESTABILIZE_RIVAL clocks aimed at this faction.
  targetedClocks Clock[] @relation("FactionTargetedClocks")

  // #13 / universal front-style threats concerning this faction, without
  // being its tracked ambition (see Clock.relatedFactionId).
  relatedClocks Clock[] @relation("FactionRelatedClocks")

  // World Sim Phase 4: NPCs affiliated with this faction (leader/members).
  members NPC[] @relation("FactionMembers")

  // World Sim Phase 4: locations this faction controls.
  territories Location[] @relation("FactionTerritories")

  // World Sim Phase 5: sustained conflicts this faction is party to.
  warsAsAttacker    War[]            @relation("WarsAsAttacker")
  warsAsDefender    War[]            @relation("WarsAsDefender")
  // Coalitions: every war this faction is actually fighting in, as either
  // the original attacker/defender or a joined ally — see WarParticipant.
  warParticipations WarParticipant[] @relation("WarParticipations")

  // Urban Shadows economy: character standings with this faction.
  characterStandings FactionStanding[]

  // Quests commissioned by this faction as an institution (#75) — distinct
  // from a quest handed over by one of its members, which links to the NPC.
  questsGiven Quest[] @relation("QuestGiverFaction")

  // #103: wake effects (institutional memory decay) currently rippling
  // INTO this faction's stability — see ActiveWake below.
  incomingWakes ActiveWake[] @relation("WakeAffectedFaction")

  // #106: supply routes this faction currently controls.
  controlledSupplyRoutes SupplyRoute[]

  // #111: faction-to-faction debts — this faction as creditor/debtor.
  creditFactionDebts FactionDebt[] @relation("FactionDebtCreditor")
  debtFactionDebts   FactionDebt[] @relation("FactionDebtDebtor")

  // Real uniqueness enforced by a case-insensitive functional index
  // (migration 20260729030000_phase1b_schema_invariants) — see NPC's
  // identical comment for why this can't be a plain Prisma @@unique.
  @@index([campaignId])
}

// #103: a temporary, decaying stability penalty rippling out from an NPC's
// death or a faction's collapse — "this institution/legend doesn't stop
// mattering the instant it's gone." One row per (source, affected faction)
// pair: sourceType/sourceEntityId identify what died/collapsed (an NPC or
// a Faction — kept as a plain checked string rather than a second Prisma
// enum, since nothing else in the schema needs to query or join on it, and
// a bare string here can't hit the #109-style enum/schema-sync trap at
// all). affectedFactionId is the real FK — the ONE faction this specific
// row's penalty applies to (a ripple to N related factions is N rows, same
// shape as WarParticipant's one-row-per-participant convention, not one
// row with an array, since each row decays independently on its own
// countdown).
//
// totalStabilityPenalty is applied to affectedFactionId's stability in
// full, in ONE step, the moment this row is created (see tick/wakeTick.ts)
// — currentTicks/maxTicks then count a fixed number of subsequent turns
// during which that penalty is gradually restored (the "decaying" part of
// "decaying over a fixed number of turns"), same currentTicks/maxTicks
// countdown shape as Clock. resolvedAt is set exactly once, the turn the
// restoration finishes, so a fully-decayed wake is never re-processed —
// same one-shot-completion-guard convention as Clock.resolvedAt.
//
// The @@unique constraint is what makes tickWake's detection idempotent:
// it only ever tries to CREATE a row for a given (source, affected
// faction) pair once — a repeat attempt (the same NPC still isAlive:false
// next tick, before this row's creation is even visible to that later
// read) fails with a real DB constraint violation, caught and skipped,
// same defensive convention Phase 1b already established for
// check-then-act name claims in npcs.ts/factions.ts/quests.ts.
model ActiveWake {
  id                    String    @id @default(cuid())
  campaignId            String
  sourceType            String // 'NPC' | 'FACTION'
  sourceEntityId        String
  sourceEntityName      String
  affectedFactionId     String
  affectedFaction       Faction   @relation("WakeAffectedFaction", fields: [affectedFactionId], references: [id], onDelete: Cascade)
  totalStabilityPenalty Int // negative — the full amount applied at creation, then gradually restored
  currentTicks          Int       @default(0)
  maxTicks              Int       @default(5)
  resolvedAt            DateTime?
  createdAt             DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceEntityId, affectedFactionId])
  @@index([campaignId])
  @@index([affectedFactionId])
}

// #111: a real faction-to-faction economic obligation — the existing Debt
// model is Character-centric (a required FK to Character, counterparty by
// string type+id) and can't be repurposed for this; a genuine
// creditor/debtor pair between two Factions needed its own model.
//
// Directional, like SupplyRoute's from/to (NOT undirected like
// LocationAdjacency) — a debt "A owes B" is a different fact from "B owes
// A", and amount is in the same Faction.resources 0-100 scale everything
// else in the tick already uses, not gold (Character-facing gold only
// exists at the questRewards.ts boundary via GOLD_PER_RESOURCE_POINT).
// Deliberately no @@unique on the (creditor, debtor) pair — like
// SupplyRoute, a faction pair can plausibly carry multiple debts over
// time.
//
// Two origination paths, both in tick/economyTick.ts:
//  - decideLoanExtension: an ally bails out a broke faction (reuses
//    factionPayout.ts's assessPayout/MAX_RESOURCE_COST_PER_PAYOUT capacity
//    math — the same shortfall logic that used to only produce a
//    discarded log line for quest-reward payouts now produces a real,
//    persisted row here instead).
//  - decideDefaultCascade: an OUTSTANDING debt whose debtor has collapsed
//    or gone broke (factionPayout.ts's BROKE_THRESHOLD) flips to
//    DEFAULTED and applies a capped stability hit to its creditor via a
//    real ActiveWake row (sourceType 'FACTION_DEFAULT') — reusing #103's
//    decay mechanism rather than inventing a parallel one-time penalty.
model FactionDebt {
  id                String            @id @default(cuid())
  campaignId        String
  creditorFactionId String
  debtorFactionId   String
  amount            Int
  status            FactionDebtStatus @default(OUTSTANDING)
  turnCreated       Int
  turnResolved      Int?
  createdAt         DateTime          @default(now())
  resolvedAt        DateTime?

  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creditorFaction Faction  @relation("FactionDebtCreditor", fields: [creditorFactionId], references: [id], onDelete: Cascade)
  debtorFaction   Faction  @relation("FactionDebtDebtor", fields: [debtorFactionId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([creditorFactionId])
  @@index([debtorFactionId, status])
  // #238 (adversarial audit): a real partial unique index enforcing at
  // most one OUTSTANDING debt per debtor faction — created by hand-written
  // migration SQL (Prisma's @@unique has no WHERE clause), same
  // NPC/Faction/Quest-name and downtime-activity (#211) precedent
  // elsewhere in this schema. The application-level findFirst-then-create
  // check in economyTick.ts is the primary gate; this is the concurrency
  // backstop. Scoped to debtorFactionId alone, matching that check's own
  // scope — "at most one outstanding debt" is per-debtor here, not
  // per-(creditor, debtor) pair.
}

enum FactionDebtStatus {
  OUTSTANDING
  DEFAULTED
  PAID
}

// #119: a generic, reusable signed/contested value — the pattern
// War.momentum already established (a tug-of-war between two sides,
// pushed each tick, clamped, resolved decisively past a threshold or by
// timeout) extracted into real, additive storage for OTHER contested
// values, starting with territory loyalty (Location.loyaltyArc).
//
// Deliberately NOT a storage migration for War itself: War.momentum stays
// exactly the plain Int column it already is — a live DB CHECK
// constraint, an AI-prompt display path (worldSummaryMappers.ts), and
// full Integrity Engine coverage all already depend on that shape, and
// nothing else needs to join against it. Only the PURE PUSH MATH is
// shared (see game/arc.ts's decideArcDelta/decideArcResolution, which
// decideWarProgress/decideWarResolution in tick/warTick.ts now delegate
// to internally) — this table is new storage for consumers that don't
// have their own dedicated column yet.
//
// `kind` is a plain string, not a Prisma enum: like ActiveWake.sourceType,
// a new kind costs nothing structurally to add later, with no risk of
// the #109-style schema/DB enum desync. `locationId` is the FIRST real
// consumer's link (one Arc per contested location, at most — the
// @@unique enforces that); a future second non-War consumer would add its
// own optional unique FK the same way Clock already has separate
// sourceFactionId/targetFactionId/relatedFactionId columns for different
// link semantics, rather than a single polymorphic "ownerId" column.
model Arc {
  id          String   @id @default(cuid())
  campaignId  String
  kind        String // e.g. 'TERRITORY_LOYALTY'
  value       Int      @default(0) // -100..100, DB CHECK Arc_value_range
  startedTurn Int // the turn this arc's contest began — feeds decideArcResolution's timeout
  locationId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location Location? @relation("LocationLoyaltyArc", fields: [locationId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([locationId])
}

//
// LOCATIONS
//

model Location {
  id           String   @id @default(cuid())
  campaignId   String
  name         String
  description  String?
  locationType String? // town, dungeon, wilderness, building, inn, etc.
  isDiscovered Boolean  @default(true) // false = exists in world but players haven't found it
  gmNotes      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // World Sim Phase 1: persistent weather, updated by the world tick and
  // surfaced to the AI prompt builder so narration references it instead of
  // reinventing it. Not a climate model - one condition + a severity scalar.
  weather          WeatherCondition @default(CLEAR)
  weatherSeverity  Int              @default(1) // 1 (mild) - 5 (extreme)
  weatherUpdatedAt DateTime? // last tick that changed the condition

  // World Sim Phase 4: which faction controls this place, if any — the map
  // EXPAND ambitions and faction collapse actually redraw. isContested is a
  // foothold state: a rival has moved against it but hasn't taken it yet
  // (set by a successful EXPAND against owned land, or a successful
  // DESTABILIZE_RIVAL scheme; cleared when it changes hands).
  ownerFactionId String?
  ownerFaction   Faction? @relation("FactionTerritories", fields: [ownerFactionId], references: [id], onDelete: SetNull)
  isContested    Boolean  @default(false)

  // Corruption gate (#83). min = only the marked may pass; max = the
  // marked are turned away. Null on both (the default) means ungated.
  // Enforced at a BOUNDARY only — never re-evaluated against state a
  // character already holds — because marks are irreversible and a
  // retroactive gate would be a one-way trap. See lib/game/corruptionGates.ts.
  // Checked on ENTRY: a character can be refused a door, never ejected
  // through one they already walked through.
  minCorruption Int?
  maxCorruption Int?

  // #109: a location's physical/social health — a city sieged twice looks
  // identical to one that's been at peace for 20 years without this.
  // 0-100, same DB-checked-range convention as War.momentum/NPC.harm
  // (DB CHECK Location_conditionScore_range, Phase 1b-style). Drifted by
  // tick/locationConditionTick.ts's decideConditionDrift: down while an
  // ESCALATING war contests this location or it's merely isContested,
  // recovering slowly in peacetime. 60 (STABLE) is the default baseline a
  // newly-created location starts at. The six-tag vocabulary
  // (RUINED/DAMAGED/STABLE/PROSPEROUS/CONTESTED/ABANDONED) this issue also
  // named is deliberately NOT a stored column — deriveConditionTags in the
  // same file computes it from conditionScore + isContested on read, so
  // the tag can never desync from the score that defines it.
  conditionScore Int @default(60)

  // #110: background population count, distinct from the named Character[]/
  // NPC[] rows below — a city can be "a city" without every resident being
  // an individually modeled entity. Nullable and untouched by default: a
  // location the GM never assigns a population to is never migrated into
  // or out of by tick/migrationTick.ts, so existing campaigns don't
  // silently start tracking a number nobody set.
  population Int?

  // #106: freeform extractable-resource-type tags this location can
  // produce (e.g. "ore", "lumber", "grain") — empty (the default) means
  // nothing to extract here. No closed enum/parse-on-read helper on
  // purpose: unlike Faction.beliefVector's fixed, individually-typed axes,
  // this is just a flat list of tags with no per-element structure to
  // validate, the same shape as Clock.participantNpcIds. Read by
  // tick/logisticsTick.ts's decideExtraction, which gates a resource gain
  // for this location's owner on an unblockaded SupplyRoute touching it.
  resourceSlots String[] @default([])

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Reverse side of Character.locationId / NPC.locationId.
  characters Character[]
  npcs       NPC[]
  // Reverse side of War.contestedLocationId.
  contestedInWars War[] @relation("WarContestedLocation")
  // #106: reverse side of SupplyRoute.fromLocationId/toLocationId.
  supplyRoutesFrom SupplyRoute[] @relation("SupplyRouteFrom")
  supplyRoutesTo   SupplyRoute[] @relation("SupplyRouteTo")
  // #108: reverse side of LocationAdjacency.locationAId/locationBId.
  adjacentAsA LocationAdjacency[] @relation("LocationAdjacencyA")
  adjacentAsB LocationAdjacency[] @relation("LocationAdjacencyB")
  // #119: this location's territory-loyalty Arc, if it's ever been
  // contested — see Arc below.
  loyaltyArc Arc? @relation("LocationLoyaltyArc")

  @@unique([campaignId, name])
  @@index([campaignId])
  @@index([ownerFactionId])
}

//
// WARS — World Sim Phase 5, with multi-faction coalitions
//
// A sustained multi-turn conflict, distinct from a one-shot ambition Clock.
// Declared deterministically when two rival factions are both militarily
// strong AND there's already contested territory between them (see
// warTick.ts) — war is the escalation of a contest, not a random event.
// Each tick while ESCALATING, momentum shifts based on the two sides'
// relative military strength (plus a small deterministic variance) and both
// sides take attrition losses regardless of who's winning. Resolves once
// momentum is decisive or the war has dragged on long enough to call a
// stalemate, at which point the contested territory's fate is settled.
//
// Coalitions: a war always DECLARES as strictly 1v1 (attackerFactionId vs
// defenderFactionId, unchanged) — coalitions grow FROM there, not at
// declaration. Each tick, a side's existing ALLY factions (see
// Faction.relationships) can be pulled in as additional WarParticipant rows
// if they're strong enough and not already committed to any other war. This
// reuses the ALLY relationship type that Phase 3 already computes but never
// gave any mechanical weight to. Momentum/attrition/resolution operate on
// the whole side (sum of all living participants' military, attrition paid
// by every living participant), but the contested territory prize still
// goes only to the original attackerFactionId — an ally fighting alongside
// doesn't inherit land it never personally claimed.

enum WarSide {
  ATTACKER
  DEFENDER
}

model War {
  id         String @id @default(cuid())
  campaignId String

  name                String
  attackerFactionId   String
  defenderFactionId   String
  // The specific prize this war is over, if any. A real FK with SetNull
  // (matching Location.ownerFactionId / Clock.sourceFactionId): this was a
  // bare id with no relation, and warTick.ts's resolution path does an
  // unguarded location.update on it — a deleted Location made that throw
  // P2025 mid-tick, which (the tick not being transactional) left the world
  // turn half-applied with its banked hours already spent.
  contestedLocationId String?

  // -100 (total defender advantage) .. +100 (total attacker advantage).
  // DB CHECK War_momentum_range (Phase 1b).
  momentum Int       @default(0)
  status   WarStatus @default(ESCALATING)
  // Set only once resolved: 'attacker' | 'defender' | 'stalemate'.
  outcome  String?

  startedTurn  Int
  resolvedTurn Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  attacker         Faction   @relation("WarsAsAttacker", fields: [attackerFactionId], references: [id], onDelete: Cascade)
  defender         Faction   @relation("WarsAsDefender", fields: [defenderFactionId], references: [id], onDelete: Cascade)
  contestedLocation Location? @relation("WarContestedLocation", fields: [contestedLocationId], references: [id], onDelete: SetNull)
  // Every faction actually fighting in this war, both sides — including the
  // original attacker/defender (given their own rows at declaration time),
  // so all war-math can read participants uniformly instead of special-
  // casing "the primary pair plus any extras."
  participants WarParticipant[]

  @@index([campaignId])
  @@index([attackerFactionId])
  @@index([defenderFactionId])
  @@index([contestedLocationId])
}

model WarParticipant {
  id         String  @id @default(cuid())
  warId      String
  factionId  String
  side       WarSide
  joinedTurn Int

  war     War     @relation(fields: [warId], references: [id], onDelete: Cascade)
  faction Faction @relation("WarParticipations", fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([warId, factionId])
  @@index([warId])
  @@index([factionId])
}

// #106: a flat, arbitrary supply line between two locations — not yet
// validated against any real spatial/adjacency data (WorldGraph, #108,
// doesn't exist yet). Ship now anyway per the decided approach: a flat
// route stays schema-valid once real adjacency lands later; only the
// pathing logic that creates/validates routes would need to improve, not
// this table. tick/logisticsTick.ts's decideExtraction gates a location's
// resource-slot yield on at least one non-blockaded route touching it —
// deliberately NOT required to terminate at a specific "faction capital"
// or validated for real reachability, since neither concept exists yet;
// that refinement is exactly what #108 unlocks later.
//
// isBlockaded is kept in sync each tick from current ESCALATING wars (see
// logisticsTick.ts, which reads the same war-presence signal
// tick/locationConditionTick.ts already established for #109) rather than
// war code writing to it directly — keeps warTick.ts's own responsibility
// (military resolution) separate from this table's.
model SupplyRoute {
  id                   String   @id @default(cuid())
  campaignId           String
  fromLocationId       String
  toLocationId         String
  controllingFactionId String?
  isBlockaded          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fromLocation       Location @relation("SupplyRouteFrom", fields: [fromLocationId], references: [id], onDelete: Cascade)
  toLocation         Location @relation("SupplyRouteTo", fields: [toLocationId], references: [id], onDelete: Cascade)
  controllingFaction Faction? @relation(fields: [controllingFactionId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([controllingFactionId])
}

// #108: a flat, undirected adjacency edge between two locations — the
// WorldGraph SupplyRoute's own schema comment already named as the future
// source of truth for real reachability. Undirected on purpose, unlike
// SupplyRoute's directional from/to naming: physical adjacency has no
// direction, and distance is symmetric by definition (distance(A,B) ===
// distance(B,A)), so storing one row per pair avoids a duplicate-data
// invariant nothing would enforce. Writers MUST always store the
// lexicographically smaller id as locationAId (plain string comparison) —
// this is what makes @@unique([locationAId, locationBId]) actually
// prevent a reverse-direction duplicate row, and it means a reader can
// look up either side with a single OR clause instead of checking both
// orderings. worldGraph.ts's shortestPath/pure helpers always expand a row
// into both directions when building their internal graph, regardless of
// which side is stored as A vs B.
model LocationAdjacency {
  id          String   @id @default(cuid())
  campaignId  String
  locationAId String
  locationBId String
  distance    Int      @default(1)
  createdAt   DateTime @default(now())

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  locationA Location @relation("LocationAdjacencyA", fields: [locationAId], references: [id], onDelete: Cascade)
  locationB Location @relation("LocationAdjacencyB", fields: [locationBId], references: [id], onDelete: Cascade)

  @@unique([locationAId, locationBId])
  @@index([campaignId])
  @@index([locationAId])
  @@index([locationBId])
}

//
// CLOCKS — FULL feature version
//

model Clock {
  id           String   @id @default(cuid())
  campaignId   String
  name         String
  description  String?
  currentTicks Int      @default(0) // required by worldTurn + stateUpdater
  maxTicks     Int      @default(4) // required by code
  category     String?
  isHidden     Boolean  @default(false)
  consequence  String? // triggered result
  gmNotes      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Set the first (and only the first) time checkAndResolveCompletedClocks
  // processes this clock after currentTicks reaches maxTicks. Without this,
  // a completed clock would be re-detected as "just completed" on every
  // subsequent turn forever, since nothing else removes or advances it past
  // maxTicks — re-firing its completion event and (for ambition clocks)
  // re-applying faction stat deltas indefinitely.
  resolvedAt DateTime?

  // World Sim Phase 2: set when a faction autonomously spawned this clock
  // while pursuing an ambitious goal, rather than a GM creating it by hand.
  sourceFactionId String?
  sourceFaction   Faction? @relation("FactionSpawnedClocks", fields: [sourceFactionId], references: [id], onDelete: SetNull)

  // World Sim Phase 3: set when this ambition is a DESTABILIZE_RIVAL clock
  // aimed at a specific rival (see relationshipTick.ts) — lets
  // resolveCompletedAmbitions in worldTurn.ts apply real stat damage to the
  // named rival on success, not just to the faction that committed to it.
  targetFactionId String?
  targetFaction   Faction? @relation("FactionTargetedClocks", fields: [targetFactionId], references: [id], onDelete: SetNull)

  // Phase 9: NPC society — set when two allied major NPCs are jointly
  // pursuing this clock (see npcSocietyTick.ts). Deliberately NOT
  // sourceFactionId even when both NPCs share a faction: sourceFactionId
  // opts a clock OUT of the generic completion narration in
  // checkAndResolveCompletedClocks (it expects the ambition-specific
  // resolver in worldTurn.ts to handle it instead), and a joint scheme has
  // no such resolver — it wants the generic path.
  participantNpcIds String[] @default([])

  // #13 / universal front-style threats: a front (template-authored or
  // AI-generated, see campaign-templates.ts's FrontTemplate and
  // worldGenerator.ts's GeneratedFront) may concern a real faction WITHOUT
  // being that faction's tracked ambition. Same reasoning as
  // participantNpcIds above — deliberately separate from sourceFactionId
  // so a front's completion routes through the generic checkAndResolve-
  // CompletedClocks path (a public flavor-text event) instead of
  // resolveCompletedAmbitions, which expects a real PendingAmbition and
  // would otherwise misapply faction stat deltas to an unrelated front.
  relatedFactionId String?
  relatedFaction   Faction? @relation("FactionRelatedClocks", fields: [relatedFactionId], references: [id], onDelete: SetNull)

  // #104: multi-stage ambitions. A plain id, NOT a self-relation FK — it
  // holds the ROOT clock's own id for every clock in a continuing agenda
  // chain, established lazily: stage 1 is created with agendaId null (no
  // chain exists yet); when resolveCompletedAmbitions (ambitionResolution.ts)
  // decides a successful ambition continues, the new stage-2 clock's
  // agendaId becomes stage 1's own id (agendaId ?? id), and every later
  // stage carries that same root id forward. A plain string avoids a
  // nullable self-FK's added complexity for what's really just a shared
  // grouping key.
  agendaId String?

  // #227: the FactionGoal this ambition clock was actually spawned to
  // pursue, snapshotted once at creation (tickFactionAmbitions / a
  // continuation in resolveCompletedAmbitions) and never updated again.
  // Only ever set on ambition clocks (sourceFactionId != null). Exists
  // because Faction.goal can drift (see beliefTick.ts) in the same tick an
  // ambition completes — reading faction.goal fresh at resolution time
  // would flavor/categorize the outcome and any continuation for whatever
  // the faction believes NOW, not what this clock was actually pursuing.
  // Null on clocks created before this field existed; resolution code
  // falls back to faction.goal in that case.
  goal FactionGoal?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([targetFactionId])
  @@index([sourceFactionId])
  @@index([agendaId])
}

//
// SCENES — FULL feature version
//

model Scene {
  id                  String      @id @default(cuid())
  campaignId          String
  sceneNumber         Int
  title               String?
  sceneIntroText      String      @db.Text // required by createNewScene()
  framing             String?     @db.Text // optional alternative, preserved
  location            String?
  participants        Json?
  status              SceneStatus @default(AWAITING_ACTIONS)
  sceneResolutionText String?     @db.Text

  // X-Card pause (see lib/safety/safety-service.ts pauseScene/resumeScene).
  // Deliberately separate from SceneStatus rather than a PAUSED enum value —
  // pausing can happen mid-AWAITING_ACTIONS or mid-RESOLVING and must
  // survive either, so it's an orthogonal flag both the action-submission
  // and resolution gates check, not a status transition.
  isPaused     Boolean   @default(false)
  pausedAt     DateTime?
  pausedReason String?

  // PbtA scene tracking
  sceneType String? @default("dramatic") // "dramatic", "downtime", "combat"
  stakes    String? // What's at risk in this scene

  // Phase 16: Freeform Combat & Exchange System
  combatMode      String? @default("freeform") // "freeform", "structured"
  exchangeState   Json? // { playersActed: string[], exchangeNumber: number, isComplete: boolean, complexity: 'simple' | 'complex' }
  currentExchange Int     @default(0)

  // Phase 14: Consequence tracking per scene
  consequences Json? // { created?: string[], resolved?: string[], relationshipChanges?: object[] }

  // Scene progress ledger: what's already been established/resolved in
  // THIS scene, reported by the narrator each exchange and read back into
  // the next prompt — replaces re-deriving "what's already happened" from
  // re-reading raw prose (see lib/game/worldUpdaters/sceneProgress.ts and
  // scenePrompt.ts's buildSceneProgressLedgerSection). Two shapes in
  // one object, deliberately not conflated (see BUG-012's event/state
  // distinction in the tracking issue):
  //   establishedFacts / resolvedBeats — APPEND-ONLY LOGS (events), each
  //     bounded (MAX_ESTABLISHED_FACTS / MAX_RESOLVED_BEATS in
  //     sceneProgress.ts), oldest trimmed first.
  //   activeConflict / npcIntentions — CURRENT VALUE (state), overwritten
  //     wholesale each time the model reports a new one, never appended.
  //   lastProgressExchange — the exchange number real progress last
  //     happened (a new beat, or activeConflict actually changing) — the
  //     stall-detection signal buildPacingSection uses instead of raw
  //     exchange count.
  // Shape: { establishedFacts: string[], resolvedBeats: [{exchange,text,
  // significant}], activeConflict: string|null, npcIntentions: {[name]:
  // string}, lastProgressExchange: number }. Null for scenes created
  // before this existed or before their first exchange resolves.
  progressState Json?

  // Phase 9: Turn tracking
  waitingOnUsers Json? // Array of user IDs who need to act

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  playerActions    PlayerAction[]
  diceRolls        DiceRoll[]
  gmClarifications GmClarification[]

  // Phase 8: Communication
  messages Message[]    @relation("SceneMessages")
  notes    PlayerNote[] @relation("SceneNotes")

  // Phase 9: Notifications
  notifications Notification[] @relation("SceneNotifications")
  turnTracker   TurnTracker[]  @relation("SceneTurnTracker")

  @@index([campaignId])
  @@index([status])
}

//
// PLAYER ACTIONS
//

model PlayerAction {
  id            String  @id @default(cuid())
  sceneId       String
  characterId   String
  userId        String
  actionText    String  @db.Text
  intentOutcome String?
  status        String  @default("pending")
  resolution    String? @db.Text
  rollResult    Json?

  // PbtA move tracking
  moveUsed     String? // Which move was triggered
  rollRequired Boolean @default(false) // Does this need a roll?
  rollMade     String? // Link to DiceRoll.id if rolled

  // Phase 16: Exchange tracking
  exchangeNumber Int? // Which exchange this action belongs to
  actionPriority Int? @default(0) // For complex exchange ordering

  createdAt DateTime @default(now())

  scene     Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sceneId])
  @@index([characterId])
}

//
// GM CLARIFICATIONS — out-of-character Q&A, deliberately NOT a PlayerAction
//
// "Ask the GM" is a meta channel: a player clarifying the fiction before
// committing to a real action ("what can I see on this person?"), answered
// from the same fog-of-war-safe knowledge the AI narrator has, but never
// treated as something that happens in the story. It must never become a
// PlayerAction row — that would make it eligible for dice classification
// (resolveActionMechanics blindly processes every pending PlayerAction) and
// exchange-completion counting (ExchangeManager). See lib/ai/askGm.ts.
model GmClarification {
  id          String   @id @default(cuid())
  campaignId  String
  sceneId     String
  characterId String
  userId      String
  question    String   @db.Text
  answer      String   @db.Text
  createdAt   DateTime @default(now())

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scene     Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([sceneId])
}

//
// TIMELINE — FULL feature version
//

model TimelineEvent {
  id            String          @id @default(cuid())
  campaignId    String
  turnNumber    Int? // required by world turn + UI
  title         String
  summaryPublic String?         @db.Text
  summaryGM     String?         @db.Text
  isOffscreen   Boolean?        @default(false)
  eventType     EventType?
  visibility    EventVisibility @default(PUBLIC)
  sessionDate   DateTime        @default(now())
  gmNotes       String?
  createdAt     DateTime        @default(now())

  // Absolute in-game day number since campaign epoch at time of writing —
  // this model had no date concept at all before this field. Null for
  // every row written before it existed; never backfilled retroactively.
  // See CampaignLog.inGameDayNumber's comment for the same reasoning.
  inGameDayNumber Int?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([turnNumber])
  @@index([campaignId, inGameDayNumber])
}

//
// WORLD META — FULL feature version
//

model WorldMeta {
  id                String  @id @default(cuid())
  campaignId        String  @unique
  currentTurnNumber Int     @default(1)
  currentInGameDate String?
  currentLocation   String?

  // Dramatic tension, 0-100. Recomputed deterministically every world turn
  // from real state — clocks near firing, active wars, party harm, live
  // threats — never set by the AI (see lib/game/tick/tension.ts). Read at
  // clock-advancement time: in a tense campaign, unattached threats close
  // faster. Both this and `phase` below spent a long time as dead columns
  // nothing wrote; they're real now (README #90).
  tension   Int      @default(50) // 0-100 — DB CHECK WorldMeta_tension_range (Phase 1b)
  // Story-arc phase derived from tension and campaign length —
  // setup / rising / climax / aftermath. Steers narration pacing.
  phase     String?
  otherMeta Json?
  gmNotes   String?
  updatedAt DateTime @updatedAt

  // Campaign lobby "World Chronicle": a few sentences of generated
  // atmosphere (weather/faction posture/conflicts), regenerated once per
  // world turn by runWorldTurn (never per page view — see
  // chronicleNarration.ts). Null until the first world turn runs.
  // chronicleNarrationTurn tracks which turn it reflects so the lobby
  // never regenerates on every view; a stale/failed generation just
  // leaves the previous turn's text in place rather than blocking.
  chronicleNarration      String? @db.Text
  chronicleNarrationTurn  Int?

  // Plain-data snapshot of the same signals as chronicleNarration above
  // (weather/top faction/conflicts/recent events), for the lobby's
  // "World at a Glance" tile row. Derived, not fetched fresh — see
  // deriveChronicleGlance in chronicleContext.ts. Shape: ChronicleGlance
  // (src/lib/game/chronicleTypes.ts).
  chronicleGlance Json?

  // World-turn pacing: the faction/NPC simulation advances with IN-GAME
  // time, not per player action. hoursSinceWorldTurn accumulates the AI's
  // time_passage each resolution; a world turn runs once it crosses
  // worldTurnHours (null = default, see lib/game/tick/pacing.ts).
  hoursSinceWorldTurn Float @default(0)
  worldTurnHours      Int?

  // Durable, monotonically-increasing total in-game hours since campaign
  // epoch (hour 0 = campaign creation) — unlike hoursSinceWorldTurn above,
  // this NEVER resets (that field is a pacing accumulator that zeroes out
  // every time a world turn fires). This is the single numeric source of
  // truth lib/game/calendar.ts's formatInGameDate reads to compute the
  // in-fiction date — currentInGameDate above is just a cached display
  // string recomputed from this number on every write, never
  // string-mutated in place the way the old calculateNewDate did.
  totalElapsedGameHours Float @default(0)

  // Real-time heartbeat (see lib/game/cronHeartbeat.ts): a pure idle
  // backstop, not an add-on to active play. The daily cron sweep tops
  // hoursSinceWorldTurn up to real elapsed time — banking the GAP between
  // real hours passed and hoursBankedSinceLastHeartbeat (what play itself
  // already banked since the last sweep), never both in full. A quiet
  // campaign gets real time banked outright; an actively-played one gets
  // nothing extra once play has already kept pace with (or outrun) the
  // real clock. lastRealTimeTickAt null means never swept — no backlog
  // banked for time before the cron existed.
  lastRealTimeTickAt            DateTime?
  hoursBankedSinceLastHeartbeat Float     @default(0)

  // World Sim Phase 8: per-tick simulation caps (how many factions/NPCs the
  // tick handlers simulate each turn — see src/lib/game/tick/caps.ts).
  // Null means "use the default" (10/20) — most campaigns never need to
  // touch this; it exists for campaigns whose faction/NPC count grows past
  // the defaults and the admin wants the tick to cover more of them.
  factionCap Int?
  npcCap     Int?

  // Phase 15: AI Health & Cost Tracking
  aiHealth              Json? // Circuit breaker state and AI failure tracking
  aiMetrics             Json? // Token usage, costs, response times
  campaignHealthHistory Json? // Historical health scores and issues
  lastHealthCheck       DateTime? // Last time health was checked
  currentHealthScore    Int? // Current campaign health (0-100)

  // Integrity Engine (world-data coherence — see game/integrity/), Phase 2.
  // Deliberately separate from campaignHealthHistory above: that measures
  // narrative/operational health (AI consistency, engagement, scene success
  // rate), this measures whether the world's own data is internally
  // consistent. Same bounded-history shape as recordHealthCheck(), storing
  // full IntegrityReport objects (see integrity/types.ts) rather than a
  // score, since there's no single number that means "coherent."
  integrityReportHistory Json? // Bounded history of past IntegrityReport objects
  lastIntegrityCheck     DateTime? // Last time an integrity pass ran

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

//
// INVITES
//

model CampaignInvite {
  id         String   @id @default(cuid())
  campaignId String
  token      String   @unique @default(cuid())
  createdBy  String
  expiresAt  DateTime
  maxUses    Int      @default(0)
  uses       Int      @default(0)
  createdAt  DateTime @default(now())

  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdByUser User     @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([campaignId])
}

//
// PHASE 7 ADDITIONS: PbtA System
//

// Per-campaign flavor text for the fixed BASIC_MOVES set (lib/pbta-moves.ts).
// The mechanics (rollType, stat, outcome bands) never vary — only the name/
// trigger/description/outcome PROSE does, generated once per campaign by
// lib/ai/moveFlavor.ts the same way statLabels/archetypes/corruptionTheme
// are, and falling back to BASIC_MOVES' own generic text when absent (no
// API key, generation failed, or a legacy row predating this feature).
// baseMoveKey ties a row back to the canonical move it flavors — see
// PbtAMove.key — and IS read at roll time: resolution.ts's computeMechanics
// looks a classified move up by this key to override its display name and
// outcome text before handing it to the narrator and the transparency
// panel. A row with baseMoveKey null is legacy flavor-only content (e.g. an
// older export) with no live effect beyond export/import round-tripping.
model Move {
  id          String   @id @default(cuid())
  campaignId  String
  baseMoveKey String? // matches PbtAMove.key in lib/pbta-moves.ts, e.g. "act_under_fire"
  name        String
  trigger     String // "When you..."
  description String   @db.Text
  rollType    String? // "roll+cool", "roll+hard", "act under fire", null for no roll
  outcomes    Json // {strongHit: "...", weakHit: "...", miss: "..."}
  category    String   @default("basic") // "basic", "special", "custom"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, baseMoveKey])
}

// DiceRoll.moveId (and Move.diceRolls above) were removed: a real roll's
// move always comes from BASIC_MOVES (lib/pbta-moves.ts) — a fixed set with
// no 1:1 row in this table, even now that Move.baseMoveKey lets resolution
// look up per-campaign flavor text for one (see the Move model's own doc
// comment) — a roll is never "the same row" as a Move, just optionally
// flavored by one, so a per-roll FK could never be populated with a
// semantically correct value. Confirmed zero application-code references
// before removal. A roll's move is identified by name in `description`
// below, which is what's actually read (formatRollReceipt in
// lib/game/resolution.ts).
model DiceRoll {
  id          String  @id @default(cuid())
  campaignId  String
  sceneId     String?
  characterId String
  userId      String

  rollType String // "move", "custom", "help", "interfere"

  dice     Int[] // [6, 4] for 2d6 showing 6 and 4
  modifier Int   @default(0) // Stat modifier or forward
  total    Int // Sum of dice + modifier

  outcome     String // "strongHit" (10+), "weakHit" (7-9), "miss" (6-)
  description String? // Context for the roll

  forward Int? @default(0) // +1 forward granted
  ongoing Int? @default(0) // +1 ongoing granted
  hold    Int? @default(0) // Hold generated

  isSecret  Boolean  @default(false) // Hidden from other players
  createdAt DateTime @default(now())

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scene     Scene?    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([sceneId])
  @@index([characterId])
}

