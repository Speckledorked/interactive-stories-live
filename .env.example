# Database
#
# #500: in a serverless deployment this MUST be a POOLED connection string.
# Each concurrent function invocation opens its own connection, so the fan-out
# of one cron sweep or a burst of players can exhaust Postgres's max_connections
# while almost every one of those connections sits idle. The symptom is not a
# slow app; it is "too many clients already" under exactly the traffic you want.
#
# On Neon that means the `-pooler` host (PgBouncer, transaction mode):
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1
#
# connection_limit=1 is correct here and looks wrong: PgBouncer is already the
# pool, so Prisma keeping its own pool per instance just holds server-side
# connections open across invocations that are no longer running.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# The SAME database, unpooled — the direct (non `-pooler`) host.
#
# Migrations and introspection cannot run through PgBouncer in transaction
# mode: they use session-level features (advisory locks, prepared statements)
# that a transaction pooler does not preserve. schema.prisma reads this as
# its `directUrl`.
#
# The name is not arbitrary. On Vercel the Neon integration creates and
# maintains DATABASE_URL_UNPOOLED itself, so reusing that name means there is
# nothing to set there and nothing to drift when Neon rotates the password.
# Locally, point it at the same database as DATABASE_URL.
#
# It must be SET wherever `prisma migrate deploy` runs. Prisma resolves every
# datasource variable before running a migration, so an unset one fails at
# config time rather than connection time — that is why CI sets it too.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/dbname"

# JWT Authentication
JWT_SECRET="your-secret-key-change-me"

# OpenAI API (for AI GM features)
OPENAI_API_KEY="sk-..."

# Anthropic API (fallback for action classification when OpenAI is unreachable)
# Both must be set for the fallback to engage; the model is never hardcoded
# so a retirement is a config change, not a code change.
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_CLASSIFICATION_MODEL="your-anthropic-model"

# Pusher (for real-time updates)
# One set of key/cluster vars serves both the client and the server — the
# client needs the NEXT_PUBLIC_ prefix to read them in the browser, and
# the server reads the exact same two vars (not a separate pair) so a
# deploy can't end up with the client configured and the server silently
# not, or vice versa. APP_ID/SECRET are server-only and must never be
# NEXT_PUBLIC_-prefixed.
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="your-pusher-cluster"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP Email Configuration (for notifications and invites)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# AI Debug Mode — DEV-ONLY, DANGEROUS. When "true", every AI GM call dumps
# the full raw system+user prompt and raw AI response to the server
# console — the entire assembled world-summary context, including GM-only
# data that legitimately reaches the prompt but isn't meant for casual log
# exposure. Never enable in production: server logs commonly have weaker
# access controls than the database itself, and this is a full campaign-
# state leak. As a backstop, this has no effect at all when
# NODE_ENV=production regardless of this setting (see client.ts).
AI_DEBUG_MODE="false"

# Platform admin analytics dashboard (/admin/analytics) — comma-separated
# email allowlist. Leave unset to disable the dashboard for everyone.
PLATFORM_ADMIN_EMAILS="you@example.com"

# Secures the internal worker routes (async scene resolution, lore import
# jobs) that self-invoke over HTTP — see lib/game/resolutionQueue.ts. Falls
# back to JWT_SECRET if unset, but set a dedicated value in production.
INTERNAL_JOB_SECRET="change-me-to-a-random-string"

# Secures the daily cron sweep (vercel.json's `crons`, api/internal/cron/
# world-tick-sweep) — Vercel automatically sends this as
# `Authorization: Bearer $CRON_SECRET` when invoking cron jobs. Required
# for the world tick to advance without a player driving traffic.
CRON_SECRET="change-me-to-a-random-string"

# Stripe (for payment processing)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Web Push (optional — browser notifications).
# Generate a keypair once with:  npx web-push generate-vapid-keys
# With these unset, push degrades to a no-op and the settings toggle is
# hidden; in-app and email notifications are unaffected.
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"
